-%>
<nav data-cy="navbar" class="navbar navbar-<% if (clientThemeNone || clientThemeVariantPrimary) { %>dark<% } else { %><%= clientThemeVariant %><% } %> navbar-expand-xl <% if (clientThemeNone) { %>bg-dark<% } else { %>bg-<%= clientThemeVariant %><% } %>">
  <div class="container-fluid">
  <a class="navbar-brand logo" routerLink="/" (click)="collapseNavbar()">
    <span class="logo-img"></span>
    <span class="navbar-title">__jhiTranslateTag__('global.title')</span>
    <span class="navbar-version">{{ version }}</span>
  </a>
  <a
    class="navbar-toggler d-lg-none"
    href="javascript:void(0);"
    data-toggle="collapse"
    data-target="#navbarResponsive"
    aria-controls="navbarResponsive"
    aria-expanded="false"
    aria-label="Toggle navigation"
    (click)="toggleNavbar()"
  >
    <fa-icon icon="bars" />
  </a>
  <div class="navbar-collapse collapse" id="navbarResponsive" [ngbCollapse]="isNavbarCollapsed()">
    <ul class="navbar-nav form-crud-main-nav ms-lg-4 me-auto">
      <li class="nav-item" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }">
        <a class="nav-link" routerLink="/" (click)="collapseNavbar()">
          <span>
            <fa-icon icon="home" />
            <span>__jhiTranslateTag__('global.menu.home')</span>
          </span>
        </a>
      </li>
<%_ if (typeof openApiOperations !== 'undefined' && openApiOperations?.length) { _%>
      @if (account() !== null) {
        <li class="nav-item" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }">
          <a class="nav-link" routerLink="/openapi-operations" (click)="collapseNavbar()" data-cy="openapiOperationsMenu">
            <span>
              <fa-icon icon="tasks" />
              <span>API operations</span>
            </span>
          </a>
        </li>
    <%_
      const formCrudTitleLabel = value => String(value)
        .replace(/[-_]+/g, ' ')
        .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
        .replace(/\b\w/g, chr => chr.toUpperCase());
      const formCrudCollectionPath = path => {
        const segments = String(path).split('?')[0].split('/').filter(Boolean);
        const firstParam = segments.findIndex(segment => segment.startsWith('{') && segment.endsWith('}'));
        return `/${(firstParam === -1 ? segments : segments.slice(0, firstParam)).join('/')}`;
      };
      const formCrudPathLabel = path => {
        const segment = formCrudCollectionPath(path).split('/').filter(Boolean).pop() ?? 'Resources';
        return formCrudTitleLabel(segment);
      };
      const formCrudSingular = label => label.replace(/ies$/i, 'y').replace(/s$/i, '');
      const formCrudNormalized = value => String(value).replace(/[^A-Za-z0-9]/g, '').toLowerCase();
      const formCrudOperationLabel = (resource, operation) => {
        if (operation.method === 'GET') return `List ${resource.label}`;
        if (operation.method === 'POST') return `Create ${formCrudSingular(resource.label)}`;
        return `${operation.method} ${resource.label}`;
      };
      const formCrudOperationIcon = operation => (operation.method === 'POST' ? 'plus' : 'list');
      const formCrudResourcesByKey = new Map();
      for (const operation of openApiOperations) {
        const basePath = formCrudCollectionPath(operation.path);
        const key = basePath.split('/').filter(Boolean).map(segment => segment.toLowerCase()).join('-') || 'resources';
        const resource = formCrudResourcesByKey.get(key) ?? {
          key,
          label: formCrudPathLabel(operation.path),
          basePath,
          operations: [],
          listOperation: undefined,
          createOperation: undefined,
        };
        resource.operations.push(operation);
        if (!/\{[^}]+}/.test(operation.path) && operation.method === 'GET') resource.listOperation ??= operation;
        if (!/\{[^}]+}/.test(operation.path) && operation.method === 'POST') resource.createOperation ??= operation;
        formCrudResourcesByKey.set(key, resource);
      }
      const formCrudResources = [...formCrudResourcesByKey.values()]
        .filter(resource => resource.listOperation || resource.createOperation)
        .sort((left, right) => left.label.localeCompare(right.label));
      const formCrudIsTmfStyleApi = openApiOperations.some(operation => /(^|\/)(hub|listener)(\/|$)/i.test(operation.path) || /^(hub|listener)$/i.test(operation.tag))
        && openApiOperations.some(operation => formCrudNormalized(`${operation.path} ${operation.tag} ${operation.operationId}`).includes('event'));
      const formCrudIsEventResource = resource => formCrudNormalized(`${resource.basePath} ${resource.label} ${resource.operations.map(operation => `${operation.tag} ${operation.operationId}`).join(' ')}`).includes('event');
      const formCrudIsIntegrationResource = resource => ['hub', 'listener', 'importjob', 'exportjob', 'event'].some(keyword =>
        formCrudNormalized(`${resource.basePath} ${resource.label} ${resource.operations.map(operation => `${operation.tag} ${operation.operationId}`).join(' ')}`).includes(keyword),
      );
      const formCrudBusinessResources = formCrudIsTmfStyleApi ? formCrudResources.filter(resource => !formCrudIsIntegrationResource(resource) && !formCrudIsEventResource(resource)) : formCrudResources;
      const formCrudIntegrationResources = formCrudIsTmfStyleApi ? formCrudResources.filter(resource => formCrudIsIntegrationResource(resource) && !formCrudIsEventResource(resource)) : [];
      const formCrudEventResources = formCrudIsTmfStyleApi ? formCrudResources.filter(resource => formCrudIsEventResource(resource)) : [];
      const formCrudRenderResourceMenu = resource => `
            <li class="dropdown-submenu dropend">
              <a class="dropdown-item dropdown-toggle" href="javascript:void(0);" data-cy="formCrudResource">
                <fa-icon icon="th-list" [fixedWidth]="true" />
                <span>${resource.label}</span>
              </a>
              <ul class="dropdown-menu form-crud-dropdown-menu">
                ${[resource.listOperation, resource.createOperation].filter(Boolean).map(operation => `
                <li>
                  <a
                    class="dropdown-item"
                    [routerLink]="['/form-crud', '${operation.id}']"
                    routerLinkActive="active"
                    (click)="collapseNavbar()"
                    data-cy="formCrudOperation"
                  >
                    <fa-icon icon="${formCrudOperationIcon(operation)}" [fixedWidth]="true" />
                    <span>${formCrudOperationLabel(resource, operation)}</span>
                  </a>
                </li>`).join('')}
              </ul>
            </li>`;
    _%>
        <li
          ngbDropdown
          class="nav-item dropdown pointer"
          display="dynamic"
          routerLinkActive="active"
          [routerLinkActiveOptions]="{ exact: true }"
        >
          <a class="nav-link dropdown-toggle" ngbDropdownToggle href="javascript:void(0);" id="form-crud-menu" data-cy="formCrudMenu">
            <span>
              <fa-icon icon="tasks" />
              <span>Form CRUD</span>
            </span>
          </a>
          <ul class="dropdown-menu form-crud-dropdown-menu" ngbDropdownMenu aria-labelledby="form-crud-menu">
    <%_ for (const resource of formCrudBusinessResources) { _%>
<%- formCrudRenderResourceMenu(resource) %>
    <%_ } _%>
    <%_ if (formCrudIntegrationResources.length || formCrudEventResources.length) { _%>
            <li class="dropdown-divider"></li>
            <li class="dropdown-submenu dropend">
              <a class="dropdown-item dropdown-toggle" href="javascript:void(0);" data-cy="formCrudIntegration">
                <fa-icon icon="tasks" [fixedWidth]="true" />
                <span>Integration</span>
              </a>
              <ul class="dropdown-menu form-crud-dropdown-menu">
      <%_ for (const resource of formCrudIntegrationResources) { _%>
<%- formCrudRenderResourceMenu(resource) %>
      <%_ } _%>
      <%_ if (formCrudEventResources.length) { _%>
                <li class="dropdown-submenu dropend">
                  <a class="dropdown-item dropdown-toggle" href="javascript:void(0);" data-cy="formCrudEvents">
                    <fa-icon icon="bell" [fixedWidth]="true" />
                    <span>Events</span>
                  </a>
                  <ul class="dropdown-menu form-crud-dropdown-menu">
        <%_ for (const resource of formCrudEventResources) { _%>
<%- formCrudRenderResourceMenu(resource) %>
        <%_ } _%>
                  </ul>
                </li>
      <%_ } _%>
              </ul>
            </li>
    <%_ } _%>
          </ul>
        </li>
      }
<%_ } _%>
      @if (account() !== null) {
        <li
          ngbDropdown
          class="nav-item dropdown pointer"
          display="dynamic"
          routerLinkActive="active"
          [routerLinkActiveOptions]="{ exact: true }"
        >
          <a class="nav-link dropdown-toggle" ngbDropdownToggle href="javascript:void(0);" id="entity-menu" data-cy="entity">
            <span>
              <fa-icon icon="th-list" />
              <span>__jhiTranslateTag__('global.menu.entities.main')</span>
            </span>
          </a>
          <ul class="dropdown-menu" ngbDropdownMenu aria-labelledby="entity-menu">
            <!-- jhipster-needle-add-entity-to-menu - JHipster will add entities to the menu here -->
<%_ if (applicationTypeGateway && microfrontend) { _%>
  <%_ for (const remote of microfrontends) { _%>
          @if (<%= remote.lowercaseBaseName %>EntityNavbarItems().length === 0) {
            <li>
              <span class="dropdown-item">Failed to load <%= remote.lowercaseBaseName %> entities</span>
            </li>
          }
          @for (entityNavbarItem of <%= remote.lowercaseBaseName %>EntityNavbarItems(); track $index) {
            <li>
              <a
                class="dropdown-item"
                [routerLink]="entityNavbarItem.route"
                routerLinkActive="active"
                [routerLinkActiveOptions]="{ exact: true }"
                (click)="collapseNavbar()"
              >
                <fa-icon icon="asterisk" [fixedWidth]="true" />
                <span
    <%_ if (enableTranslation) { _%>
               [<%= jhiPrefix %>Translate]="entityNavbarItem.translationKey"
    <%_ } _%>
                >{{entityNavbarItem.name}}</span>
              </a>
            </li>
        }
  <%_ } _%>
<%_ } _%>
          </ul>
        </li>
      }
      <li
        *<%= jhiPrefix %>HasAnyAuthority="'ROLE_ADMIN'"
        ngbDropdown
        class="nav-item dropdown pointer"
        display="dynamic"
        routerLinkActive="active"
        [routerLinkActiveOptions]="{ exact: true }"
      >
        <a class="nav-link dropdown-toggle" ngbDropdownToggle href="javascript:void(0);" id="admin-menu" data-cy="adminMenu">
          <span>
            <fa-icon icon="users-cog" />
            <span>__jhiTranslateTag__('global.menu.admin.main')</span>
          </span>
        </a>
        <ul class="dropdown-menu" ngbDropdownMenu aria-labelledby="admin-menu">
          <!-- jhipster-needle-add-element-to-admin-menu - JHipster will add entities to the admin menu here -->
<%_ if (typeof openApiOperations !== 'undefined' && openApiOperations?.length) { _%>
          <li>
            <a class="dropdown-item" routerLink="/admin/form-crud-reference-pickers" routerLinkActive="active" (click)="collapseNavbar()" data-cy="formCrudReferencePickersMenu">
              <fa-icon icon="search" [fixedWidth]="true" />
              <span>Form CRUD reference pickers</span>
            </a>
          </li>
<%_ } _%>
<%_ if (applicationTypeGateway && gatewayServicesApiAvailable) { _%>
          <li>
            <a class="dropdown-item" routerLink="/admin/gateway" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="road" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.gateway')</span>
            </a>
          </li>
<%_ } _%>
<%_ if (generateUserManagement && userManagement.skipClient) { _%>
          <li>
            <a class="dropdown-item" routerLink="/admin/user-management" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="users" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.userManagement')</span>
            </a>
          </li>
<%_ } _%>
<%_ if (communicationSpringWebsocket) { _%>
          <li>
            <a class="dropdown-item" routerLink="/admin/tracker" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="eye" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.tracker')</span>
            </a>
          </li>
<%_ } _%>
<%_ if (withAdminUi) { _%>
          <li>
            <a class="dropdown-item" routerLink="/admin/metrics" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="tachometer-alt" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.metrics')</span>
            </a>
          </li>
          <li>
            <a class="dropdown-item" routerLink="/admin/health" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="heart" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.health')</span>
            </a>
          </li>
          <li>
            <a class="dropdown-item" routerLink="/admin/configuration" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="cogs" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.configuration')</span>
            </a>
          </li>
          <li>
            <a class="dropdown-item" routerLink="/admin/logs" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="tasks" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.logs')</span>
            </a>
          </li>
<%_ } _%>
<%_ if (!applicationTypeMicroservice) { _%>
        @if (openAPIEnabled()) {
          <li>
            <a class="dropdown-item" routerLink="/admin/docs" routerLinkActive="active" (click)="collapseNavbar()">
              <fa-icon icon="book" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.apidocs')</span>
            </a>
          </li>
        }
<%_ } _%>
<%_ if (devDatabaseTypeH2Any || databaseTypeCouchbase) { _%>
        @if (!inProduction()) {
          <li>
            <a class="dropdown-item" href="<% if (databaseTypeCouchbase) { %>http://localhost:8091/<% } else if (reactive) { %> http://localhost:8092/ <% } else { %>./h2-console/<% } %>" target="_tab" (click)="collapseNavbar()">
              <fa-icon icon="database" [fixedWidth]="true" />
              <span>__jhiTranslateTag__('global.menu.admin.database')</span>
            </a>
          </li>
        }
<%_ } _%>
        </ul>
      </li>
<%_ if (enableTranslation) { _%>
    @if (languages && languages.length > 1) {
      <li ngbDropdown class="nav-item dropdown pointer" display="dynamic">
        <a class="nav-link dropdown-toggle" ngbDropdownToggle href="javascript:void(0);" id="languagesnavBarDropdown">
          <span>
            <fa-icon icon="flag" />
            <span>__jhiTranslateTag__('global.menu.language')</span>
          </span>
        </a>
        <ul class="dropdown-menu" ngbDropdownMenu aria-labelledby="languagesnavBarDropdown">
        @for (language of languages; track $index) {
          <li>
            <a class="dropdown-item" [<%= jhiPrefix %>ActiveMenu]="language" href="javascript:void(0);" (click)="changeLanguage(language);collapseNavbar();">{{ language | findLanguageFromKey }}</a>
          </li>
        }
        </ul>
      </li>
    }
<%_ } _%>
      <li ngbDropdown class="nav-item dropdown pointer" display="dynamic" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }">
        @let accountRef = account();
        <a class="nav-link dropdown-toggle" ngbDropdownToggle href="javascript:void(0);" id="account-menu" data-cy="accountMenu">
        @if (!accountRef?.imageUrl) {
          <span>
            <fa-icon icon="user" />
            <span>__jhiTranslateTag__('global.menu.account.main')</span>
          </span>
        } @else {
          <span>
            <img [src]="accountRef!.imageUrl" class="profile-image rounded-circle" alt="Avatar" />
          </span>
        }
        </a>
        <ul class="dropdown-menu" ngbDropdownMenu aria-labelledby="account-menu">
          @if (accountRef !== null) {
<%_ if (generateUserManagement) { _%>
            <li>
              <a class="dropdown-item" routerLink="/account/settings" routerLinkActive="active" (click)="collapseNavbar()" data-cy="settings">
                <fa-icon icon="wrench" [fixedWidth]="true" />
                <span>__jhiTranslateTag__('global.menu.account.settings')</span>
              </a>
            </li>
            <li>
              <a class="dropdown-item" routerLink="/account/password" routerLinkActive="active" (click)="collapseNavbar()" data-cy="passwordItem">
                <fa-icon icon="lock" [fixedWidth]="true" />
                <span>__jhiTranslateTag__('global.menu.account.password')</span>
              </a>
            </li>
<%_ } _%>
<%_ if (authenticationTypeSession && generateUserManagement) { _%>
            <li>
              <a class="dropdown-item" routerLink="/account/sessions" routerLinkActive="active" (click)="collapseNavbar()">
                <fa-icon icon="cloud" [fixedWidth]="true" />
                <span>__jhiTranslateTag__('global.menu.account.sessions')</span>
              </a>
            </li>
<%_ } _%>
            <li>
              <a class="dropdown-item" (click)="logout()" id="logout" data-cy="logout">
                <fa-icon icon="sign-out-alt" [fixedWidth]="true" />
                <span>__jhiTranslateTag__('global.menu.account.logout')</span>
              </a>
            </li>
          } @else {
            <li>
              <a class="dropdown-item" (click)="login()" id="login" data-cy="login">
                <fa-icon icon="sign-in-alt" [fixedWidth]="true" />
                <span>__jhiTranslateTag__('global.menu.account.login')</span>
              </a>
            </li>
<%_ if (generateUserManagement) { _%>
            <li>
              <a class="dropdown-item" routerLink="/account/register" routerLinkActive="active" (click)="collapseNavbar()" data-cy="register">
                <fa-icon icon="user-plus" [fixedWidth]="true" />
                <span>__jhiTranslateTag__('global.menu.account.register')</span>
              </a>
            </li>
<%_ } _%>
          }
        </ul>
      </li>
    </ul>
  </div>
  </div>
</nav>
