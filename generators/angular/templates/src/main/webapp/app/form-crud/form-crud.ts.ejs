import { CommonModule, DOCUMENT } from '@angular/common';
import { HttpClient, HttpContext, HttpHeaders, HttpParams, HttpResponse } from '@angular/common/http';
import { Component, OnDestroy, OnInit, inject, signal } from '@angular/core';
import { AbstractControl, FormGroup, ReactiveFormsModule } from '@angular/forms';
import { ActivatedRoute, RouterLink } from '@angular/router';
import { FieldArrayType, FieldWrapper, FormlyConfig, FormlyFieldConfig, FormlyForm, FormlyModule } from '@ngx-formly/core';
import { Subscription } from 'rxjs';
import { finalize } from 'rxjs/operators';

import SharedModule from 'app/shared/shared.module';
import { SKIP_AUTH_EXPIRED_LOGOUT } from 'app/core/interceptor/auth-expired.interceptor';

import {
  FORM_CRUD_REFERENCE_PICKER_STORAGE_KEY,
  FormCrudReferencePickerConfig,
  OPENAPI_OPERATIONS,
  OpenApiOperationDefinition,
  OpenApiOperationParameter,
  OpenApiSchemaField,
} from 'app/openapi-operations/openapi-operations.model';

type FormCrudModel = {
  parameters: Record<string, unknown>;
  body: unknown;
};

type ResponseRow = {
  item: unknown;
  cells: Record<string, unknown>;
};

type ReferencePickerState = {
  fieldPath: string;
  field: OpenApiSchemaField;
  config: FormCrudReferencePickerConfig;
  targetModel: Record<string, unknown>;
  targetForm: FormGroup;
  formValue: Record<string, unknown>;
};

type CrudResource = {
  key: string;
  label: string;
  basePath: string;
  operations: readonly OpenApiOperationDefinition[];
  listOperation?: OpenApiOperationDefinition;
  createOperation?: OpenApiOperationDefinition;
  detailOperation?: OpenApiOperationDefinition;
  updateOperation?: OpenApiOperationDefinition;
  deleteOperation?: OpenApiOperationDefinition;
};

type CrudResourceGroup = {
  key: string;
  label: string;
  resources: readonly CrudResource[];
  childGroups?: readonly CrudResourceGroup[];
};

type FormCrudDebugWindow = Window & {
  __formsDebug?: Record<string, unknown>;
};

type BodySerializationOptions = {
  includeEmptyStructures?: boolean;
  omitAbsentEmptyStructures?: boolean;
  originalSource?: unknown;
};

@Component({
  selector: '<%= jhiPrefixDashed %>-form-crud-section-wrapper',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="accordion mb-3" [attr.data-cy]="'formCrudSection-' + (props.label ?? 'section')">
      <div class="accordion-item" [class.border-danger]="hasValidationErrors()">
        <h4 class="accordion-header">
          <button class="accordion-button" [class.collapsed]="!isOpen" [attr.aria-expanded]="isOpen" type="button" (click)="toggle()">
            <span>{{ props.label }}</span>
            <span *ngIf="props.requiredIndicator ?? props.required" class="badge text-bg-primary ms-2">Required</span>
            <span *ngIf="hasValidationErrors()" class="badge text-bg-danger ms-2">Contains errors</span>
            <span class="ms-auto"></span>
          </button>
        </h4>
        <div class="accordion-collapse collapse" [class.show]="isOpen">
          <div class="accordion-body">
            <div class="d-flex justify-content-end mb-2" *ngIf="props.clearable">
              <button class="btn btn-outline-secondary btn-sm" type="button" (click)="clearValue()">Clear</button>
            </div>
            <div *ngIf="props.description" class="form-text mb-3">{{ props.description }}</div>
            <ng-container #fieldComponent></ng-container>
          </div>
        </div>
      </div>
    </div>
  `,
})
class FormCrudSectionWrapper extends FieldWrapper implements OnInit {
  isOpen = false;

  ngOnInit(): void {
    this.isOpen = this.props.expanded === true;
  }

  toggle(): void {
    this.isOpen = !this.isOpen;
  }

  clearValue(): void {
    this.formControl.reset({});
  }

  hasValidationErrors(): boolean {
    return this.formControl.invalid && (this.formControl.touched || this.formControl.dirty);
  }
}

