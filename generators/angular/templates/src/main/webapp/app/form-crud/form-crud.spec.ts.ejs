  it('should render all required request schema fields and block invalid create submits', () => {
    const operation = OPENAPI_OPERATIONS.find(candidate => candidate.method === 'POST' && requiredRequestFieldNames(candidate).length > 0);
    if (!operation) {
      expect(OPENAPI_OPERATIONS.some(candidate => candidate.method === 'POST' && requiredRequestFieldNames(candidate).length > 0)).toBe(false);
      return;
    }
    routeParams.next(convertToParamMap({ operationId: operation.id }));
    fixture.detectChanges();

    const fieldKeys = flattenFieldKeys(comp.fields);
    for (const requiredField of requiredRequestFieldNames(operation)) {
      expect(fieldKeys).toContain(requiredField);
    }

    const fieldToClear = scalarRequiredRequestFields(operation).at(0);
    if (!fieldToClear) {
      expect(requiredRequestFieldNames(operation).length).toBeGreaterThan(0);
      return;
    }

    const control = formControlForBodyField(fieldToClear);
    expect(control).toBeTruthy();
    control?.setValue('');
    control?.markAsTouched();
    comp.submit();

    if (requiredRequestFieldNames(operation).length > 0) {
      httpMock.expectNone(req => req.url.startsWith('/api'));
      expect(comp.form.invalid).toBe(true);
    }
  });

  it('should map backend validation errors back to matching Formly controls', () => {
    const operation = OPENAPI_OPERATIONS.find(candidate => candidate.method === 'POST' && requiredRequestFieldNames(candidate).length > 0);
    if (!operation) {
      expect(OPENAPI_OPERATIONS.some(candidate => candidate.method === 'POST' && requiredRequestFieldNames(candidate).length > 0)).toBe(false);
      return;
    }
    const requiredField = scalarRequiredRequestFields(operation).at(0);
    if (!requiredField) {
      expect(scalarRequiredRequestFields(operation).length).toBe(0);
      return;
    }

    routeParams.next(convertToParamMap({ operationId: operation.id }));
    fixture.detectChanges();
    const control = formControlForBodyField(requiredField);
    expect(control).toBeTruthy();
    control?.setValue(clientValidValueForField(requiredField));

    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    request.flush({ fieldErrors: [{ field: requiredField.name, message: 'Backend validation failed' }] }, { status: 400, statusText: 'Bad Request' });

    expect(comp.responseStatus()).toBe(400);
    expect(comp.responseError()).toContain(requiredField.name);
    expect(control?.errors?.backend).toBe('Backend validation failed');
  });

