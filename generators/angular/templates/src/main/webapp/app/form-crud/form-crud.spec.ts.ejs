  it('should match reference pickers to the configured operation form and avoid duplicate api prefixes', () => {
    const renderer = schemaRenderer(comp);
    const operation: OpenApiOperationDefinition = {
      ...operationWithBody(),
      id: 'patch-update-resource',
      operationId: 'updateResource',
      method: 'PATCH',
      path: '/resources/{id}',
      parameters: [{ name: 'id', location: 'path', required: true, type: 'integer' }],
    };
    const field: OpenApiSchemaField = {
      name: 'references',
      pointer: '/references',
      path: ['references'],
      required: false,
      nullable: false,
      type: 'array',
      items: {
        name: 'reference',
        pointer: '/references/0',
        path: ['references', '0'],
        required: false,
        nullable: false,
        type: 'object',
        fields: [{ name: 'href', pointer: '/references/0/href', path: ['references', '0', 'href'], required: false, nullable: false, type: 'string' }],
      },
    };
    localStorage.setItem(
      FORM_CRUD_REFERENCE_PICKER_STORAGE_KEY,
      JSON.stringify([
        {
          id: 'references',
          formId: 'patch-update-resource',
          sourcePath: 'references',
          targetBaseUrl: 'http://localhost:4201/api',
          collectionPath: '/api/targets',
          displayFields: ['href'],
          copyFields: [{ source: 'href', target: 'href' }],
          mode: 'reference',
          multiple: true,
        },
      ]),
    );

    const createField = renderer.schemaField(field, false, 0, {}, undefined, {}, { ...operation, id: 'post-create-resource', method: 'POST', path: '/resources' });
    const updateField = renderer.schemaField(field, false, 0, {}, undefined, {}, operation);

    expect(createField.props?.referencePicker).toBeUndefined();
    expect(updateField.props?.referencePicker).toBeDefined();
    const sameOriginApi = `${window.location.origin}/api`;
    expect(renderer.referencePickerUrl({ targetBaseUrl: sameOriginApi, collectionPath: '/api/targets' })).toBe('/api/targets');
    expect(renderer.referencePickerUrl({ targetBaseUrl: sameOriginApi, collectionPath: '/targets' })).toBe('/api/targets');
    expect(renderer.referencePickerUrl({ targetBaseUrl: 'https://example.invalid/api', collectionPath: '/api/targets' })).toBe(
      'https://example.invalid/api/targets',
    );
    expect(renderer.referencePickerUrl({ targetBaseUrl: 'https://example.invalid/api', collectionPath: '/targets' })).toBe(
      'https://example.invalid/api/targets',
    );
  });
