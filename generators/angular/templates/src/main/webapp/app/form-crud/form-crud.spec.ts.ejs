<%_ if (clientTestFrameworkVitest) { _%>
import { afterEach, beforeEach, describe, expect, it } from 'vitest';
<%_ } _%>
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { convertToParamMap, ActivatedRoute } from '@angular/router';
import { FaIconLibrary } from '@fortawesome/angular-fontawesome';
import { faEye, faList, faSave, faSync, faTimes, faTrashAlt } from '@fortawesome/free-solid-svg-icons';
import { withFormlyBootstrap } from '@ngx-formly/bootstrap';
import { FormlyFieldConfig, provideFormlyCore } from '@ngx-formly/core';
import { BehaviorSubject } from 'rxjs';

import {
  FORM_CRUD_REFERENCE_PICKER_STORAGE_KEY,
  OPENAPI_OPERATIONS,
  OpenApiOperationDefinition,
  OpenApiSchemaField,
} from 'app/openapi-operations/openapi-operations.model';
import FormCrud from './form-crud';

declare global {
  interface Window {
    __formsDebug?: Record<string, unknown>;
  }
}

type MutableFormControl = {
  setValue(value: unknown): void;
  markAsTouched(): void;
  errors: Record<string, unknown> | null;
};

describe('FormCrud', () => {
  let fixture: ComponentFixture<FormCrud>;
  let comp: FormCrud;
  let httpMock: HttpTestingController;
  let routeParams: BehaviorSubject<ReturnType<typeof convertToParamMap>>;

  function operationWithBody(): OpenApiOperationDefinition {
    const bodyOperations = OPENAPI_OPERATIONS.filter(operation => operation.requestContentType?.includes('json') && operation.requestBodyFields?.length);
    return (
      bodyOperations.find(operation => !operation.path.includes('{')) ??
      bodyOperations.find(operation => operation.parameters.every(parameter => !parameter.required)) ??
      bodyOperations[0] ??
      OPENAPI_OPERATIONS[0]
    );
  }

  function collectionReadOperation(): OpenApiOperationDefinition | undefined {
    return OPENAPI_OPERATIONS.find(operation => operation.method === 'GET' && !operation.path.includes('{'));
  }

  function flattenFieldKeys(fields: readonly FormlyFieldConfig[]): string[] {
    const keys: string[] = [];
    for (const field of fields) {
      if (typeof field.key === 'string') keys.push(field.key);
      if (field.fieldGroup) keys.push(...flattenFieldKeys(field.fieldGroup));
      const arrayField = field.fieldArray;
      if (arrayField && !Array.isArray(arrayField) && typeof arrayField !== 'function' && arrayField.fieldGroup) {
        keys.push(...flattenFieldKeys(arrayField.fieldGroup));
      }
    }
    return keys;
  }

  function requiredRequestFieldNames(operation: OpenApiOperationDefinition): string[] {
    return (operation.requestBodyFields ?? []).filter(field => field.required).map(field => field.name);
  }

  function scalarRequiredRequestFields(operation: OpenApiOperationDefinition): OpenApiSchemaField[] {
    return (operation.requestBodyFields ?? []).filter(field => field.required && !['array', 'object', 'boolean'].includes(field.type));
  }

  function formControlForBodyField(field: OpenApiSchemaField): MutableFormControl | null {
    return comp.form.get(`body.${field.name}`) as MutableFormControl | null;
  }

  function clientValidValueForField(field: OpenApiSchemaField): unknown {
    if (field.example !== undefined) return field.example;
    if (field.defaultValue !== undefined) return field.defaultValue;
    if (field.enumValues?.length) return field.enumValues[0];
    if (field.type === 'integer' || field.type === 'number') return field.minimum ?? 0;
    if (field.format === 'date') return '2026-01-01';
    if (field.format === 'date-time') return '2026-01-01T00:00:00';
    if (field.format === 'email') return 'user@example.com';
    return 'value';
  }

  function schemaRenderer(component: FormCrud): {
    schemaField(
      field: OpenApiSchemaField,
      readonly?: boolean,
      depth?: number,
      targetModel?: Record<string, unknown>,
      targetForm?: unknown,
      formValue?: Record<string, unknown>,
      operation?: OpenApiOperationDefinition,
    ): FormlyFieldConfig;
    schemaFieldGroup(
      fields: readonly OpenApiSchemaField[],
      readonly?: boolean,
      depth?: number,
      targetModel?: Record<string, unknown>,
      targetForm?: unknown,
      formValue?: Record<string, unknown>,
      operation?: OpenApiOperationDefinition,
    ): FormlyFieldConfig[];
    initialFieldValue(field: OpenApiSchemaField): unknown;
    valueForField(field: OpenApiSchemaField, rawValue: unknown): unknown;
    validationViolations(value: unknown): { path: string; message: string }[];
    detailValueForField(field: OpenApiSchemaField, value: unknown): unknown;
    bodyForOperation(
      operation: OpenApiOperationDefinition,
      bodySource?: unknown,
      bodyFields?: readonly OpenApiSchemaField[],
      options?: boolean | { includeEmptyStructures?: boolean; omitAbsentEmptyStructures?: boolean; originalSource?: unknown },
    ): unknown;
    initialModel(operation: OpenApiOperationDefinition): { parameters: Record<string, unknown>; body: unknown };
    detailSchemaFields(resource: unknown): readonly OpenApiSchemaField[];
    mergeSubmittedDetailWithResponse(submitted: unknown, response: unknown): unknown;
    referencePickerUrl(config: { targetBaseUrl?: string; collectionPath: string }): string;
    invalidControlSummaries(control: unknown): { path: string; errors: Record<string, unknown> }[];
  } {
    return component as unknown as {
      schemaField(
        field: OpenApiSchemaField,
        readonly?: boolean,
        depth?: number,
        targetModel?: Record<string, unknown>,
        targetForm?: unknown,
        formValue?: Record<string, unknown>,
        operation?: OpenApiOperationDefinition,
      ): FormlyFieldConfig;
      schemaFieldGroup(
        fields: readonly OpenApiSchemaField[],
        readonly?: boolean,
        depth?: number,
        targetModel?: Record<string, unknown>,
        targetForm?: unknown,
        formValue?: Record<string, unknown>,
        operation?: OpenApiOperationDefinition,
      ): FormlyFieldConfig[];
      initialFieldValue(field: OpenApiSchemaField): unknown;
      valueForField(field: OpenApiSchemaField, rawValue: unknown): unknown;
      validationViolations(value: unknown): { path: string; message: string }[];
      detailValueForField(field: OpenApiSchemaField, value: unknown): unknown;
      bodyForOperation(
        operation: OpenApiOperationDefinition,
        bodySource?: unknown,
        bodyFields?: readonly OpenApiSchemaField[],
        options?: boolean | { includeEmptyStructures?: boolean; omitAbsentEmptyStructures?: boolean; originalSource?: unknown },
      ): unknown;
      initialModel(operation: OpenApiOperationDefinition): { parameters: Record<string, unknown>; body: unknown };
      detailSchemaFields(resource: unknown): readonly OpenApiSchemaField[];
      mergeSubmittedDetailWithResponse(submitted: unknown, response: unknown): unknown;
      referencePickerUrl(config: { targetBaseUrl?: string; collectionPath: string }): string;
      invalidControlSummaries(control: unknown): { path: string; errors: Record<string, unknown> }[];
    };
  }

  beforeEach(() => {
    localStorage.removeItem(FORM_CRUD_REFERENCE_PICKER_STORAGE_KEY);
    routeParams = new BehaviorSubject(convertToParamMap({ operationId: operationWithBody().id }));
    TestBed.configureTestingModule({
      imports: [FormCrud],
      providers: [
        provideHttpClient(),
        provideHttpClientTesting(),
        provideFormlyCore(withFormlyBootstrap()),
        { provide: ActivatedRoute, useValue: { paramMap: routeParams.asObservable() } },
      ],
    });

    TestBed.inject(FaIconLibrary).addIcons(faEye, faList, faSave, faSync, faTimes, faTrashAlt);
    fixture = TestBed.createComponent(FormCrud);
    comp = fixture.componentInstance;
    httpMock = TestBed.inject(HttpTestingController);
    fixture.detectChanges();
  });

  afterEach(() => {
    httpMock.verify();
    localStorage.removeItem(FORM_CRUD_REFERENCE_PICKER_STORAGE_KEY);
  });

  it('should create Formly fields for the selected OpenAPI operation', () => {
    const operation = operationWithBody();

    expect(comp.selectedOperation().id).toBe(operation.id);
    expect(comp.fields.length).toBeGreaterThan(0);
    expect(comp.model).toBeDefined();
  });

  it('should submit generated JSON from the Formly model', () => {
    const operation = operationWithBody();
    const renderer = schemaRenderer(comp);

    expect(renderer.invalidControlSummaries(comp.form)).toEqual([]);
    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    if (operation.requestContentType) {
      expect(request.request.headers.get('Content-Type')).toBe(operation.requestContentType);
      expect(request.request.body).toBeDefined();
    }
    request.flush({ status: 'ok' });
    for (const refreshRequest of httpMock.match(req => req.method === 'GET' && req.url.startsWith('/api'))) {
      refreshRequest.flush([{ id: 1, status: 'ok' }]);
    }

    expect(comp.responseStatus()).toBe(200);
  });

  it('should initialize required string parameters with submit-safe values', () => {
    const operation = OPENAPI_OPERATIONS.find(candidate =>
      candidate.parameters.some(parameter => parameter.required && parameter.type === 'string' && parameter.example === undefined && parameter.defaultValue === undefined),
    );
    if (!operation) {
      expect(
        OPENAPI_OPERATIONS.some(candidate =>
          candidate.parameters.some(parameter => parameter.required && parameter.type === 'string' && parameter.example === undefined && parameter.defaultValue === undefined),
        ),
      ).toBe(false);
      return;
    }

    routeParams.next(convertToParamMap({ operationId: operation.id }));
    fixture.detectChanges();

    const renderer = schemaRenderer(comp);
    expect(renderer.invalidControlSummaries(comp.form)).toEqual([]);
    for (const parameter of operation.parameters.filter(candidate => candidate.required && candidate.type === 'string')) {
      expect(comp.model.parameters[encodeURIComponent(`${parameter.location}:${parameter.name}`)]).toBeTruthy();
    }
  });

  it('should preserve OpenAPI parameter examples and constraints in initial parameter values', () => {
    const operation = OPENAPI_OPERATIONS.find(candidate =>
      candidate.parameters.some(
        parameter =>
          parameter.required &&
          parameter.type === 'string' &&
          (parameter.example !== undefined || parameter.pattern !== undefined || parameter.minLength !== undefined || parameter.maxLength !== undefined),
      ),
    );
    if (!operation) {
      expect(
        OPENAPI_OPERATIONS.some(candidate =>
          candidate.parameters.some(
            parameter =>
              parameter.required &&
              parameter.type === 'string' &&
              (parameter.example !== undefined || parameter.pattern !== undefined || parameter.minLength !== undefined || parameter.maxLength !== undefined),
          ),
        ),
      ).toBe(false);
      return;
    }

    routeParams.next(convertToParamMap({ operationId: operation.id }));
    fixture.detectChanges();

    const renderer = schemaRenderer(comp);
    expect(renderer.invalidControlSummaries(comp.form)).toEqual([]);
    for (const parameter of operation.parameters.filter(candidate => candidate.required && candidate.type === 'string')) {
      const value = comp.model.parameters[encodeURIComponent(`${parameter.location}:${parameter.name}`)];
      if (parameter.example !== undefined) expect(value).toBe(parameter.example);
      if (parameter.minLength !== undefined) expect(String(value).length).toBeGreaterThanOrEqual(parameter.minLength);
      if (parameter.maxLength !== undefined) expect(String(value).length).toBeLessThanOrEqual(parameter.maxLength);
      if (parameter.pattern !== undefined) expect(new RegExp(parameter.pattern).test(String(value))).toBe(true);
    }
  });

  it('should expose a forms debug hook for browser fuzzing', () => {
    const debugProvider = window.__formsDebug?.formCrud as (() => unknown) | undefined;
    const debug = debugProvider ? (debugProvider() as { operationId?: string; valid?: boolean; resourceGroups?: unknown[] }) : undefined;

    expect(debug?.operationId).toBe(comp.selectedOperation().id);
    expect(typeof debug?.valid).toBe('boolean');
    expect(Array.isArray(debug?.resourceGroups)).toBe(true);
  });

  it('should present read responses as a table and load selected rows into Formly detail fields', () => {
    const operation = collectionReadOperation();
    if (!operation) {
      expect(OPENAPI_OPERATIONS.some(candidate => candidate.method === 'GET' && !candidate.path.includes('{'))).toBe(false);
      return;
    }

    routeParams.next(convertToParamMap({ operationId: operation.id }));
    fixture.detectChanges();

    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    request.flush([{ id: 1, name: 'Alpha', nested: { status: 'active' } }]);
    fixture.detectChanges();

    expect(comp.responseRows().length).toBe(1);
    expect(comp.responseColumns()).toContain('id');

    comp.selectResponseItem(comp.responseRows()[0]);
    if (comp.currentResource()?.detailOperation) {
      const detailRequest = httpMock.expectOne(req => req.method === 'GET' && req.url.startsWith('/api') && req.url !== request.request.url);
      detailRequest.flush({ id: 1, name: 'Alpha', nested: { status: 'active' } });
    }
    fixture.detectChanges();

    expect(comp.selectedResponseItem()).toBeDefined();
    expect(comp.responseDetailFields.length).toBeGreaterThan(0);
    expect(comp.responseDetailModel).toBeDefined();
  });

  it('should group Form CRUD resources by collection path and keep item operations inside the resource workflow', () => {
    const collectionOperations = OPENAPI_OPERATIONS.filter(operation => !operation.path.includes('{') && ['GET', 'POST'].includes(operation.method));
    const itemOperations = OPENAPI_OPERATIONS.filter(operation => operation.path.includes('{') && ['GET', 'PATCH', 'PUT', 'DELETE'].includes(operation.method));

    expect(comp.resources.length).toBeGreaterThan(0);
    for (const operation of collectionOperations) {
      expect(comp.resources.some(resource => resource.operations.includes(operation))).toBe(true);
    }
    for (const operation of itemOperations) {
      const resource = comp.resources.find(candidate => candidate.operations.includes(operation));
      const hasCollectionWorkflow = collectionOperations.some(candidate => candidate.path === operation.path.replace(/\/\{[^}]+}.*$/, ''));
      if (hasCollectionWorkflow) {
        expect(resource).toBeDefined();
      }
      expect(resource?.listOperation === operation || resource?.createOperation === operation).toBe(false);
    }
  });

  it('should expose a collapsible resource panel state', () => {
    expect(comp.isResourcePanelCollapsed()).toBe(false);

    comp.toggleResourcePanel();
    fixture.detectChanges();

    const debugProvider = window.__formsDebug?.formCrud as (() => unknown) | undefined;
    const debug = debugProvider ? (debugProvider() as { resourcePanelCollapsed?: boolean }) : undefined;

    expect(comp.isResourcePanelCollapsed()).toBe(true);
    expect(debug?.resourcePanelCollapsed).toBe(true);
  });

  it('should group integration and event resources only for APIs with TMF-style integration metadata', () => {
    const hasHubOrListener = OPENAPI_OPERATIONS.some(operation => /(^|\/)(hub|listener)(\/|$)/i.test(operation.path) || /^(hub|listener)$/i.test(operation.tag));
    const hasEvent = OPENAPI_OPERATIONS.some(operation => `${operation.path} ${operation.tag} ${operation.operationId}`.replace(/[^A-Za-z0-9]/g, '').toLowerCase().includes('event'));
    const integrationGroup = comp.resourceGroups.find(group => group.key === 'integration');
    const hasIntegrationResource = comp.resources.some(resource =>
      /hub|listener|importjob|exportjob|event/.test(
        `${resource.basePath} ${resource.label} ${resource.operations.map(operation => `${operation.tag} ${operation.operationId}`).join(' ')}`
          .replace(/[^A-Za-z0-9]/g, '')
          .toLowerCase(),
      ),
    );

    if (hasHubOrListener && hasEvent && hasIntegrationResource) {
      expect(integrationGroup).toBeDefined();
    } else {
      expect(integrationGroup).toBeUndefined();
    }
  });

  it('should save selected list items with the resource update operation and delete with confirmation', () => {
    const operation = collectionReadOperation();
    if (!operation) {
      expect(OPENAPI_OPERATIONS.some(candidate => candidate.method === 'GET' && !candidate.path.includes('{'))).toBe(false);
      return;
    }

    routeParams.next(convertToParamMap({ operationId: operation.id }));
    fixture.detectChanges();
    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    request.flush([{ id: 1, name: 'Alpha' }]);

    comp.selectResponseItem(comp.responseRows()[0]);
    if (comp.currentResource()?.detailOperation) {
      const detailRequest = httpMock.expectOne(req => req.method === 'GET' && req.url.startsWith('/api') && req.url !== request.request.url);
      detailRequest.flush({ id: 1, name: 'Alpha' });
    }

    comp.saveSelectedItem();
    const updateOperation = comp.currentResource()?.updateOperation;
    if (updateOperation) {
      const updateRequest = httpMock.expectOne(req => req.method === updateOperation.method && req.url.startsWith('/api') && !req.url.includes('{'));
      updateRequest.flush({ id: 1, name: 'Alpha' });

      expect(comp.detailStatus()).toBe(200);
    } else {
      expect(comp.detailError()).toBe('');
    }

    const originalConfirm = window.confirm;
    window.confirm = () => true;
    try {
      comp.deleteResponseItem(comp.responseRows()[0]);
      const deleteOperation = comp.currentResource()?.deleteOperation;
      if (deleteOperation) {
        const deleteRequest = httpMock.expectOne(req => req.method === 'DELETE' && req.url.startsWith('/api') && !req.url.includes('{'));
        deleteRequest.flush('', { status: 204, statusText: 'No Content' });

        expect(comp.deleteStatus()).toBe(204);
        expect(comp.responseRows().length).toBe(0);
      } else {
        expect(comp.deleteStatus()).toBeNull();
      }
    } finally {
      window.confirm = originalConfirm;
    }
  });

  it('should render nested objects and arrays as structured Bootstrap/Formly sections', () => {
    const renderer = schemaRenderer(comp);
    const nestedObject = renderer.schemaField({
      name: 'profile',
      pointer: '/profile',
      path: ['profile'],
      required: true,
      nullable: false,
      type: 'object',
      fields: [
        { name: 'displayName', pointer: '/profile/displayName', path: ['profile', 'displayName'], required: true, nullable: false, type: 'string' },
        { name: 'age', pointer: '/profile/age', path: ['profile', 'age'], required: false, nullable: false, type: 'integer' },
      ],
    });
    const objectArraySchema: OpenApiSchemaField = {
      name: 'items',
      pointer: '/items',
      path: ['items'],
      required: false,
      nullable: false,
      type: 'array',
      items: {
        name: 'item',
        pointer: '/items/0',
        path: ['items', '0'],
        required: false,
        nullable: false,
        type: 'object',
        fields: [{ name: 'code', pointer: '/items/0/code', path: ['items', '0', 'code'], required: true, nullable: false, type: 'string' }],
      },
    };
    const objectArray = renderer.schemaField(objectArraySchema);
    const objectArrayFromExampleSchema: OpenApiSchemaField = {
      name: 'references',
      pointer: '/references',
      path: ['references'],
      required: false,
      nullable: false,
      type: 'array',
      example: [{ href: '/api/resources/1', name: 'Reference 1' }],
      items: {
        name: 'reference',
        pointer: '/references/0',
        path: ['references', '0'],
        required: false,
        nullable: false,
        type: 'string',
        example: 'string',
      },
    };
    const freeObjectSchema: OpenApiSchemaField = {
      name: 'metadata',
      pointer: '/metadata',
      path: ['metadata'],
      required: false,
      nullable: false,
      type: 'object',
      example: { source: 'openapi' },
    };
    const objectArrayFromExample = renderer.schemaField(objectArrayFromExampleSchema);
    const freeObject = renderer.schemaField(freeObjectSchema);

    expect(nestedObject.wrappers).toContain('form-crud-accordion');
    expect(nestedObject.type).toBeUndefined();
    expect(objectArray.type).toBe('form-crud-repeat');
    expect(objectArray.fieldArray).toBeDefined();
    const arrayField = objectArray.fieldArray;
    if (arrayField && !Array.isArray(arrayField) && typeof arrayField !== 'function') {
      expect(flattenFieldKeys([arrayField])).toContain('code');
    }
    const inferredArrayField = objectArrayFromExample.fieldArray;
    expect(objectArrayFromExample.type).toBe('form-crud-repeat');
    if (inferredArrayField && !Array.isArray(inferredArrayField) && typeof inferredArrayField !== 'function') {
      expect(flattenFieldKeys([inferredArrayField])).toContain('href');
      expect(flattenFieldKeys([inferredArrayField])).toContain('name');
      expect(inferredArrayField.type).not.toBe('input');
    }
    expect(freeObject.type).toBe('textarea');
    expect(renderer.valueForField(objectArraySchema, [{ code: 'A1' }])).toEqual([{ code: 'A1' }]);
    expect(renderer.valueForField(freeObjectSchema, '{"source":"openapi"}')).toEqual({ source: 'openapi' });
  });

  it('should preserve nested object fields inside array item forms without stringifying them as objects', () => {
    const renderer = schemaRenderer(comp);
    const objectArraySchema: OpenApiSchemaField = {
      name: 'items',
      pointer: '/items',
      path: ['items'],
      required: false,
      nullable: false,
      type: 'array',
      example: [{ code: 'A1', validity: { startDateTime: '2026-01-01T00:00:00Z' } }],
      items: {
        name: 'item',
        pointer: '/items/0',
        path: ['items', '0'],
        required: false,
        nullable: false,
        type: 'object',
        fields: [
          { name: 'code', pointer: '/items/0/code', path: ['items', '0', 'code'], required: true, nullable: false, type: 'string' },
          {
            name: 'validity',
            pointer: '/items/0/validity',
            path: ['items', '0', 'validity'],
            required: false,
            nullable: false,
            type: 'object',
            example: { startDateTime: '2026-01-01T00:00:00Z' },
            fields: [
              {
                name: 'startDateTime',
                pointer: '/items/0/validity/startDateTime',
                path: ['items', '0', 'validity', 'startDateTime'],
                required: false,
                nullable: false,
                type: 'string',
                format: 'date-time',
              },
            ],
          },
        ],
      },
    };

    const field = renderer.schemaField(objectArraySchema);
    const initialValue = renderer.initialFieldValue(objectArraySchema) as Record<string, unknown>[];
    const arrayField = field.fieldArray;

    expect(field.type).toBe('form-crud-repeat');
    expect(initialValue[0]?.validity).toEqual({ startDateTime: '2026-01-01T00:00:00' });
    expect(typeof initialValue[0]?.validity).toBe('object');
    expect(initialValue[0]?.validity).not.toBe('[object Object]');
    if (arrayField && !Array.isArray(arrayField) && typeof arrayField !== 'function') {
      expect(flattenFieldKeys([arrayField])).toContain('validity');
      expect(flattenFieldKeys([arrayField])).toContain('startDateTime');
    }
    expect(renderer.valueForField(objectArraySchema, initialValue)).toEqual([
      { code: 'A1', validity: { startDateTime: '2026-01-01T00:00:00Z' } },
    ]);
  });

  it('should serialize inferred object array items as JSON objects instead of scalar strings', () => {
    const renderer = schemaRenderer(comp);
    const arraySchema: OpenApiSchemaField = {
      name: 'containers',
      pointer: '/containers',
      path: ['containers'],
      required: false,
      nullable: false,
      type: 'array',
      example: [{ cargoGrossWeight: { value: 36000, unit: 'KGM' } }],
      items: {
        name: 'container',
        pointer: '/containers/0',
        path: ['containers', '0'],
        required: false,
        nullable: false,
        type: 'string',
        example: 'string',
      },
    };

    const field = renderer.schemaField(arraySchema);
    const fieldArray = field.fieldArray;

    expect(field.type).toBe('form-crud-repeat');
    if (fieldArray && !Array.isArray(fieldArray) && typeof fieldArray !== 'function') {
      expect(flattenFieldKeys([fieldArray])).toContain('cargoGrossWeight');
      expect(fieldArray.type).not.toBe('input');
    }
    expect(renderer.valueForField(arraySchema, [{ cargoGrossWeight: { value: 36000, unit: 'KGM' } }])).toEqual([
      { cargoGrossWeight: { value: 36000, unit: 'KGM' } },
    ]);
    expect(renderer.valueForField(arraySchema, [{ cargoGrossWeight: '{"value":36000,"unit":"KGM"}' }])).toEqual([
      { cargoGrossWeight: { value: 36000, unit: 'KGM' } },
    ]);
  });

  it('should infer operation-example array object items and ignore empty optional placeholders', () => {
    const renderer = schemaRenderer(comp);
    const operation: OpenApiOperationDefinition = {
      ...operationWithBody(),
      requestBodyExample: {
        references: [{ href: '/targets/1', name: 'Target' }],
        optionalUnknownItems: [{}],
      },
      requestBodyFields: [
        {
          name: 'references',
          pointer: '/references',
          path: ['references'],
          required: false,
          nullable: false,
          type: 'array',
        },
        {
          name: 'optionalUnknownItems',
          pointer: '/optionalUnknownItems',
          path: ['optionalUnknownItems'],
          required: false,
          nullable: false,
          type: 'array',
        },
      ],
    };

    const model = renderer.initialModel(operation);

    expect(model.body).toEqual({
      references: [{ href: '/targets/1', name: 'Target' }],
      optionalUnknownItems: [],
    });
    expect(renderer.bodyForOperation(operation, model.body, operation.requestBodyFields)).toEqual({
      references: [{ href: '/targets/1', name: 'Target' }],
    });
  });

  it('should replace invalid example discriminator values with schema-allowed values in nested payloads', () => {
