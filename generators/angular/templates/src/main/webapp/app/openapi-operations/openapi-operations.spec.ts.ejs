<%_ if (clientTestFrameworkVitest) { _%>
import { afterEach, beforeEach, describe, expect, it } from 'vitest';
<%_ } _%>
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { ComponentFixture, TestBed } from '@angular/core/testing';

import { OPENAPI_OPERATIONS, OpenApiOperationDefinition } from './openapi-operations.model';
import OpenApiOperations from './openapi-operations';

describe('OpenApiOperations', () => {
  let fixture: ComponentFixture<OpenApiOperations>;
  let comp: OpenApiOperations;
  let httpMock: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting()],
    });

    fixture = TestBed.createComponent(OpenApiOperations);
    comp = fixture.componentInstance;
    httpMock = TestBed.inject(HttpTestingController);
  });

  afterEach(() => {
    httpMock.verify();
  });

  function firstOperation(): OpenApiOperationDefinition {
    return OPENAPI_OPERATIONS[0];
  }

  function operationWithJsonBody(): OpenApiOperationDefinition | undefined {
    return OPENAPI_OPERATIONS.find(candidate => candidate.requestContentType?.includes('json'));
  }

  function fillRequiredParameters(operation: OpenApiOperationDefinition): void {
    for (const parameter of operation.parameters) {
      const control = comp.operationForm.controls[comp.controlName(parameter)];
      if (parameter.required && !control.value) {
        control.setValue(parameter.type === 'integer' || parameter.type === 'number' ? '1' : 'test-value');
      }
    }
  }

  it('should create controls for OpenAPI operation metadata', () => {
    const operation = firstOperation();

    for (const parameter of operation.parameters) {
      expect(comp.operationForm.controls[comp.controlName(parameter)]).toBeDefined();
    }
    if (operation.requestContentType) {
      expect(comp.operationForm.controls.body).toBeDefined();
    }
  });

  it('should submit the selected operation and capture the response', () => {
    const operation = firstOperation();
    fillRequiredParameters(operation);
    if (operation.requestContentType && !comp.operationForm.controls.body.value) {
      comp.operationForm.controls.body.setValue('{}');
    }

    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    request.flush({ status: 'ok' });

    expect(comp.responseStatus()).toBe(200);
    expect(comp.responseBody()).toContain('ok');
  });

  it('should submit JSON request bodies from operation metadata', () => {
    const operation = operationWithJsonBody();
    if (!operation) return;

    comp.selectOperation(operation.id);
    fillRequiredParameters(operation);
    if (operation.requestBodyExample !== undefined) {
      expect(comp.operationForm.controls.body.value).toBe(JSON.stringify(operation.requestBodyExample, null, 2));
    } else if (!comp.operationForm.controls.body.value) {
      comp.operationForm.controls.body.setValue('{}');
    }

    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    expect(request.request.headers.get('Content-Type')).toBe(operation.requestContentType);
    if (operation.requestBodyExample !== undefined) {
      expect(request.request.body).toEqual(operation.requestBodyExample);
    }
    request.flush({ status: 'ok' });
  });
});
