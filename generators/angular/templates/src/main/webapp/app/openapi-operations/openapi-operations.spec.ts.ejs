<%_ if (clientTestFrameworkVitest) { _%>
import { afterEach, beforeEach, describe, expect, it } from 'vitest';
<%_ } _%>
import { HttpHeaders, HttpParams, provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { FormControl } from '@angular/forms';

import { OPENAPI_OPERATIONS, OpenApiOperationDefinition } from './openapi-operations.model';
import OpenApiOperations from './openapi-operations';

describe('OpenApiOperations', () => {
  let fixture: ComponentFixture<OpenApiOperations>;
  let comp: OpenApiOperations;
  let httpMock: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting()],
    });

    fixture = TestBed.createComponent(OpenApiOperations);
    comp = fixture.componentInstance;
    httpMock = TestBed.inject(HttpTestingController);
  });

  afterEach(() => {
    httpMock.verify();
  });

  function firstOperation(): OpenApiOperationDefinition {
    return OPENAPI_OPERATIONS[0];
  }

  function operationWithJsonBody(): OpenApiOperationDefinition | undefined {
    return OPENAPI_OPERATIONS.find(candidate => candidate.requestContentType?.includes('json'));
  }

  function fillRequiredParameters(operation: OpenApiOperationDefinition): void {
    for (const parameter of operation.parameters) {
      const control = comp.operationForm.controls[comp.controlName(parameter)];
      if (parameter.required && !control.value) {
        control.setValue(parameter.type === 'integer' || parameter.type === 'number' ? '1' : 'test-value');
      }
    }
  }

  function componentInternals(component: OpenApiOperations): {
    createForm(operation: OpenApiOperationDefinition): OpenApiOperations['operationForm'];
    bodyValidators(operation: OpenApiOperationDefinition): ((control: FormControl<string>) => Record<string, boolean> | null)[];
    initialBodyValue(operation: OpenApiOperationDefinition): string;
    buildRequest(operation: OpenApiOperationDefinition): {
      method: string;
      url: string;
      params: HttpParams;
      headers: HttpHeaders;
      body: unknown;
    };
    requestBodyFor(operation: OpenApiOperationDefinition, rawBody: string | undefined): unknown;
    bodyUsesStructuredText(operation: OpenApiOperationDefinition): boolean;
    parseJsonIfPossible(value: string): unknown;
    formControlValue(value: unknown): string;
    formatBody(value: unknown): string;
  } {
    return component as unknown as {
      createForm(operation: OpenApiOperationDefinition): OpenApiOperations['operationForm'];
      bodyValidators(operation: OpenApiOperationDefinition): ((control: FormControl<string>) => Record<string, boolean> | null)[];
      initialBodyValue(operation: OpenApiOperationDefinition): string;
      buildRequest(operation: OpenApiOperationDefinition): {
        method: string;
        url: string;
        params: HttpParams;
        headers: HttpHeaders;
        body: unknown;
      };
      requestBodyFor(operation: OpenApiOperationDefinition, rawBody: string | undefined): unknown;
      bodyUsesStructuredText(operation: OpenApiOperationDefinition): boolean;
      parseJsonIfPossible(value: string): unknown;
      formControlValue(value: unknown): string;
      formatBody(value: unknown): string;
    };
  }

  it('should create controls for OpenAPI operation metadata', () => {
    const operation = firstOperation();

    for (const parameter of operation.parameters) {
      expect(comp.operationForm.controls[comp.controlName(parameter)]).toBeDefined();
    }
    if (operation.requestContentType) {
      expect(comp.operationForm.controls.body).toBeDefined();
    }
  });

  it('should submit the selected operation and capture the response', () => {
    const operation = firstOperation();
    fillRequiredParameters(operation);
    if (operation.requestContentType && !comp.operationForm.controls.body.value) {
      comp.operationForm.controls.body.setValue('{}');
    }

    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    request.flush({ status: 'ok' });

    expect(comp.responseStatus()).toBe(200);
    expect(comp.responseBody()).toContain('ok');
  });

  it('should submit JSON request bodies from operation metadata', () => {
    const operation = operationWithJsonBody();
    if (!operation) return;

    comp.selectOperation(operation.id);
    fillRequiredParameters(operation);
    if (operation.requestBodyExample !== undefined) {
      expect(comp.operationForm.controls.body.value).toBe(JSON.stringify(operation.requestBodyExample, null, 2));
    } else if (!comp.operationForm.controls.body.value) {
      comp.operationForm.controls.body.setValue('{}');
    }

    comp.submit();

    const request = httpMock.expectOne(req => req.method === operation.method && req.url.startsWith('/api'));
    expect(request.request.headers.get('Content-Type')).toBe(operation.requestContentType);
    if (operation.requestBodyExample !== undefined) {
      expect(request.request.body).toEqual(operation.requestBodyExample);
    }
    request.flush({ status: 'ok' });
  });

  it('should reject invalid required controls and expose an HTTP error response', () => {
    const internal = componentInternals(comp);
    const operation: OpenApiOperationDefinition = {
      ...firstOperation(),
      id: 'get-required-filter',
      method: 'GET',
      path: '/coverage/{id}',
      parameters: [
        { name: 'id', location: 'path', required: true, type: 'string' },
        { name: 'filter', location: 'query', required: false, type: 'string' },
      ],
      requestBodyRequired: false,
      requestContentType: undefined,
      requestBodyExample: undefined,
    };
    comp.selectedOperation.set(operation);
    comp.operationForm = internal.createForm(operation);
    const idControl = comp.operationForm.controls[comp.controlName(operation.parameters[0])];
    idControl.setValue('');
    idControl.markAsTouched();

    expect(comp.controlInvalid(comp.controlName(operation.parameters[0]))).toBe(true);
    comp.submit();
    httpMock.expectNone(req => req.url.startsWith('/api/coverage'));

    idControl.setValue('item/1');
    comp.submit();
    const request = httpMock.expectOne('/api/coverage/item%2F1');
    request.flush({ detail: 'Rejected by the API' }, { status: 422, statusText: 'Unprocessable Entity' });

    expect(comp.responseStatus()).toBe(422);
    expect(comp.responseError()).toContain('Rejected by the API');
    expect(comp.isSubmitting()).toBe(false);
  });

  it('should build path, query, header, cookie, and JSON body request values', () => {
    const internal = componentInternals(comp);
    const operation: OpenApiOperationDefinition = {
      ...firstOperation(),
      id: 'post-request-parts',
      method: 'POST',
      path: 'coverage/{id}',
      parameters: [
        { name: 'id', location: 'path', required: true, type: 'string' },
        { name: 'filter', location: 'query', required: false, type: 'string' },
        { name: 'X-Coverage', location: 'header', required: false, type: 'string' },
        { name: 'session', location: 'cookie', required: false, type: 'string' },
      ],
      requestBodyRequired: true,
      requestContentType: 'application/json',
      requestBodyExample: { name: 'Coverage' },
    };
    comp.selectedOperation.set(operation);
    comp.operationForm = internal.createForm(operation);
    comp.operationForm.controls['path:id'].setValue('item/1');
    comp.operationForm.controls['query:filter'].setValue('active');
    comp.operationForm.controls['header:X-Coverage'].setValue('enabled');
    comp.operationForm.controls['cookie:session'].setValue('cookie value');

    const request = internal.buildRequest(operation);

    expect(request.method).toBe('POST');
    expect(request.url).toBe('/api/coverage/item%2F1');
    expect(request.params.get('filter')).toBe('active');
    expect(request.headers.get('X-Coverage')).toBe('enabled');
    expect(request.headers.get('Content-Type')).toBe('application/json');
    expect(request.body).toEqual({ name: 'Coverage' });
    expect(document.cookie).toContain('session=cookie%20value');
    expect(comp.parameterInputType({ name: 'count', location: 'query', required: false, type: 'integer' })).toBe('number');
    expect(comp.parameterInputType({ name: 'date', location: 'query', required: false, type: 'string', format: 'date' })).toBe('date');
    expect(comp.parameterInputType({ name: 'time', location: 'query', required: false, type: 'string', format: 'date-time' })).toBe(
      'datetime-local',
    );
    expect(comp.parameterInputType({ name: 'name', location: 'query', required: false, type: 'string' })).toBe('text');
    expect(comp.parametersFor('query')).toHaveLength(1);
    expect(comp.hasParameters('header')).toBe(true);
    expect(comp.hasParameters('cookie')).toBe(true);
  });

  it('should validate and serialize each supported request body representation', () => {
    const internal = componentInternals(comp);
    const jsonOperation: OpenApiOperationDefinition = {
      ...firstOperation(),
      id: 'post-json-body',
      method: 'POST',
      path: '/coverage',
      parameters: [],
      requestBodyRequired: true,
      requestContentType: 'application/problem+json',
      requestBodyExample: { name: 'Coverage' },
    };
    comp.selectedOperation.set(jsonOperation);
    comp.operationForm = internal.createForm(jsonOperation);
    comp.operationForm.controls.body.setValue('{invalid');
    comp.operationForm.controls.body.markAsTouched();

    expect(comp.bodyInvalid()).toBe(true);
    expect(internal.bodyValidators(jsonOperation)).toHaveLength(2);
    expect(internal.requestBodyFor(jsonOperation, '{"name":"Coverage"}')).toEqual({ name: 'Coverage' });
    expect(internal.requestBodyFor(jsonOperation, '')).toBeNull();
    expect(internal.initialBodyValue({ ...jsonOperation, requestBodyExample: null })).toBe('');
    expect(internal.initialBodyValue({ ...jsonOperation, requestContentType: 'text/plain', requestBodyExample: 'plain' })).toBe('plain');

    const formOperation = { ...jsonOperation, requestContentType: 'application/x-www-form-urlencoded' };
    expect(internal.requestBodyFor(formOperation, '{"name":"Coverage","empty":null}')).toBe('name=Coverage');
    expect(internal.requestBodyFor(formOperation, 'plain')).toBe('plain');

    const multipartOperation = { ...jsonOperation, requestContentType: 'multipart/form-data' };
    const multipartBody = internal.requestBodyFor(multipartOperation, '{"name":"Coverage","empty":null}');
    expect(multipartBody).toBeInstanceOf(FormData);
    expect((multipartBody as FormData).get('name')).toBe('Coverage');
    const scalarMultipartBody = internal.requestBodyFor(multipartOperation, 'plain');
    expect((scalarMultipartBody as FormData).get('value')).toBe('plain');

    expect(internal.bodyUsesStructuredText({ ...jsonOperation, requestContentType: undefined })).toBe(false);
    expect(internal.bodyUsesStructuredText(formOperation)).toBe(true);
    expect(internal.parseJsonIfPossible('{"ok":true}')).toEqual({ ok: true });
    expect(internal.parseJsonIfPossible('plain')).toBe('plain');
    expect(internal.formControlValue(undefined)).toBe('');
    expect(internal.formControlValue(true)).toBe('true');
    expect(internal.formControlValue({ ok: true })).toBe('{"ok":true}');
    expect(internal.formatBody('{"ok":true}')).toContain('"ok": true');
    expect(internal.formatBody('plain')).toBe('plain');
    expect(internal.formatBody(null)).toBe('');
  });
});
