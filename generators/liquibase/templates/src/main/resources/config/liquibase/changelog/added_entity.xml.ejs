-%>
<%- include('/liquibase-changelog-header') -%>

<%_ const inheritedFieldNames = new Set();
    let inheritanceCursor = entity.parentEntity;
    while (inheritanceCursor?.fields) {
      for (const inheritedField of inheritanceCursor.fields) inheritedFieldNames.add(inheritedField.fieldName);
      inheritanceCursor = inheritanceCursor.parentEntity;
    }
    const declaredFields = fields.filter(field => !inheritedFieldNames.has(field.fieldName));
    const sqlStringLiteral = value => `'${String(value).replace(/'/g, "''")}'`;
    const checkConstraintName = columnName =>
      this.getUXConstraintName(entity.entityTableName, columnName, entity.prodDatabaseType).replace(/^ux_/, 'ck_');
      const enumCheckSqls = [];
      const writtenCheckConstraintNames = new Set();
      for (const field of declaredFields) {
        if (!field.fieldIsEnum || !field.columnName || field.columnName === entity.discriminatorColumn?.name) continue;
        const values = field.enumValues?.length
          ? field.enumValues.map(enumValue => typeof enumValue === 'string' ? enumValue : enumValue.name)
          : String(field.fieldValues ?? '')
          .split(',')
          .map(value => value.trim().replace(/\(.+\)$/, ''))
          .filter(Boolean);
        const uniqueValues = [...new Set(values.filter(Boolean))];
        const constraintName = checkConstraintName(field.columnName);
        if (uniqueValues.length === 0 || writtenCheckConstraintNames.has(constraintName)) continue;
        writtenCheckConstraintNames.add(constraintName);
        enumCheckSqls.push(
          `ALTER TABLE ${entity.entityTableName} ADD CONSTRAINT ${constraintName} CHECK (${field.columnName} IN (${uniqueValues.map(sqlStringLiteral).join(', ')}))`,
        );
      }
      const discriminatorValues = entity.polymorphicRoot
        ? [...new Set(Object.values(entity.discriminatorColumn?.values ?? {}).map(value => String(value).trim()).filter(Boolean))]
        : [];
      const discriminatorSqlLiteral = value =>
        entity.discriminatorColumn?.discriminatorType === 'INTEGER' && /^-?\d+$/.test(value) ? value : sqlStringLiteral(value);
        const discriminatorCheckSql
          = entity.discriminatorColumn && discriminatorValues.length > 0
          ? `ALTER TABLE ${entity.entityTableName} ADD CONSTRAINT ${checkConstraintName(entity.discriminatorColumn.name)} CHECK (${entity.discriminatorColumn.name} IN (${discriminatorValues.map(discriminatorSqlLiteral).join(', ')}))`
          : undefined;
_%>
<%_ for (const [idx, field] of declaredFields.filter(field => field.liquibaseCustomSequenceGenerator).entries()) { _%>
    <changeSet id="<%- changelogDate %>-seq-<%- idx %>" author="jhipster">
        <createSequence sequenceName="<%- field.liquibaseSequenceGeneratorName %>" startValue="1050" incrementBy="50"/>
    </changeSet>

<%_ } _%>
    <!--
        Added the entity <%- entity.entityClass %>.
    -->
    <changeSet id="<%- changelogDate %>-1" author="jhipster">
        <createTable tableName="<%- entity.entityTableName %>"<%- this.formatAsLiquibaseRemarks(entity.documentation, true) %>>
<%_ const { parentEntity } = entity; _%>
<%_ const inheritedPrimaryKey = parentEntity?.primaryKey; _%>
<%_ const writtenColumnNames = new Set(); _%>
<%_ if (entity.polymorphicChild && inheritedPrimaryKey) { _%>
  <%_ for (const inheritedField of inheritedPrimaryKey.fields) { _%>
            <column name="<%- inheritedField.columnName %>" type="<%- inheritedField.columnType %>">
                <constraints primaryKey="true" nullable="false"/>
            </column>
    <%_ writtenColumnNames.add(inheritedField.columnName); _%>
  <%_ } _%>
<%_ } _%>
<%_ if (entity.polymorphicRoot && entity.discriminatorColumn) { _%>
            <column name="<%- entity.discriminatorColumn.name %>" type="<%- entity.discriminatorColumn.sqlType %>">
                <constraints nullable="false"/>
            </column>
  <%_ writtenColumnNames.add(entity.discriminatorColumn.name); _%>
<%_ } _%>
<%_ for (field of declaredFields) { _%>
  <%_ if (field.columnName && writtenColumnNames.has(field.columnName)) continue; _%>
  <%_ if (field.columnName) writtenColumnNames.add(field.columnName); _%>
            <column name="<%- field.columnName %>" type="<%- field.columnType %>"<%- this.createDefaultValueLiquibaseAttribute(field, true) -%><%- this.formatAsLiquibaseRemarks(field.documentation, true) %><%- field.id && field.liquibaseAutoIncrement ? ' autoIncrement="true" startWith="1500"' : '' %>>
  <%_ if (field.id) { _%>
                <constraints primaryKey="true" nullable="false"/>
  <%_ } else if (field.unique) { _%>
                <constraints nullable="<%- !field.columnRequired %>" unique="true" uniqueConstraintName="<%- field.uniqueConstraintName %>" />
  <%_ } else { _%>
                <constraints nullable="<%- !field.columnRequired %>" />
  <%_ } _%>
            </column>
  <%_ if (field.shouldCreateContentType) { _%>
            <column name="<%- field.columnName %>_content_type" type="varchar(255)">
                <constraints nullable="<%- !field.columnRequired %>" />
            </column>
  <%_ } _%>
<%_ } _%>
<%_ for (relationship of relationships) { _%>
  <%_ if ((relationship.relationshipType === 'many-to-one' || relationship.relationshipType === 'one-to-one' && relationship.ownerSide) && !relationship.id) { _%>
    <%_ for (const idField of relationship.otherEntity.primaryKey.fields) { _%>
      <%_ const uniqueConstraintName = relationship.relationshipType === 'one-to-one' ? this.getUXConstraintName(entity.entityTableName, `${relationship.columnName}_${idField.columnName}`, entity.prodDatabaseType) : null; _%>
            <column name="<%- relationship.columnName %>_<%- idField.columnName %>" type="<%- idField.columnType %>">
                <constraints nullable="<%- !relationship.columnRequired %>"<% if (uniqueConstraintName) { %> unique="true" uniqueConstraintName="<%- uniqueConstraintName %>"<% } %> />
            </column>
    <%_ } _%>
  <%_ } _%>
<%_ } _%>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
<%_ if (discriminatorCheckSql) { _%>
        <sql><%- discriminatorCheckSql %></sql>
<%_ } _%>
<%_ for (const enumCheckSql of enumCheckSqls) { _%>
        <sql><%- enumCheckSql %></sql>
<%_ } _%>
<%_ for (const field of declaredFields) { _%>
  <%_ if (field.shouldDropDefaultValue) { _%>
        <dropDefaultValue tableName="<%- entity.entityTableName %>" columnName="<%- field.columnName %>" columnDataType="${datetimeType}"/>
  <%_ } _%>
<%_ } _%>
    </changeSet>
<%_ const joinTableRelations = relationships.filter(rel => rel.shouldWriteJoinTable); _%>
<%_ if (joinTableRelations.length > 0) { _%>

    <changeSet id="<%- changelogDate %>-1-relations" author="jhipster">
  <%_ for (relationship of joinTableRelations) { _%>

        <createTable tableName="<%- relationship.joinTable.name %>">
    <%_ for (field of relationship.otherEntity.primaryKey.fields) { _%>
            <column name="<%- relationship.columnName %>_<%- field.columnName %>" type="<%- field.columnType %>">
                <constraints nullable="false"/>
            </column>
    <%_ } _%>
    <%_ for (field of entity.primaryKey.fields) { _%>
            <column name="<%- entity.entityTableName %>_<%- field.columnName %>" type="<%- field.columnType %>">
                <constraints nullable="false"/>
            </column>
    <%_ } _%>
        </createTable>

        <addPrimaryKey columnNames="<%- entity.primaryKey.fields.map(field => `${entity.entityTableName}_${field.columnName}`).join(', ') %>, <%- relationship.otherEntity.primaryKey.fields.map(field => `${relationship.columnName}_${field.columnName}`).join(', ') %>" tableName="<%- relationship.joinTable.name %>"/>
  <%_ } _%>
    </changeSet>
<%_ } _%>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
<%_ if (!skipFakeData) { _%>

    <!--
        Load sample data generated with Faker.js
        - This data can be easily edited using a CSV editor (or even MS Excel) and
          is located in the 'src/main/resources/config/liquibase/fake-data' directory
        - By default this data is applied when running with the JHipster 'dev' profile.
          This can be customized by adding or removing 'faker' in the 'spring.liquibase.contexts'
          Spring Boot configuration key.
    -->
    <changeSet id="<%- changelogDate %>-1-data" author="jhipster" context="faker">
        <loadData
                  file="../fake-data/<%- entity.incrementalChangelog ? `${databaseChangelog.changelogDate}_entity_${entity.entityTableName}` : entity.entityTableName %>.csv"
                  relativeToChangelogFile="true"
                  separator=";"
                  tableName="<%- entity.entityTableName %>"
                  usePreparedStatements="true">
  <%_ const writtenLoadColumnNames = new Set(); _%>
  <%_ for (field of fields) { _%>
    <%_ if (field.columnName && writtenLoadColumnNames.has(field.columnName)) continue; _%>
    <%_ if (field.columnName) writtenLoadColumnNames.add(field.columnName); _%>
            <column name="<%- field.columnName %>" type="<%- field.loadColumnType %>"/>
    <%_ if (field.fieldType === 'byte[]' && field.fieldTypeBlobContent !== 'text') { _%>
      <%_ writtenLoadColumnNames.add(`${field.columnName}_content_type`); _%>
            <column name="<%- field.columnName %>_content_type" type="string"/>
    <%_ } _%>
  <%_ } _%>
  <%_ for (relationship of relationships.filter(relationship => !relationship.id && relationship.columnRequired && relationship.persistableRelationship && !relationship.collection)) { _%>
    <%_ for (field of relationship.otherEntity.primaryKey.fields) { _%>
      <%_ const relationshipColumnName = `${relationship.columnName}_${field.columnName}`; _%>
      <%_ if (writtenLoadColumnNames.has(relationshipColumnName)) continue; _%>
      <%_ writtenLoadColumnNames.add(relationshipColumnName); _%>
            <column name="<%- relationship.columnName %>_<%- field.columnName %>" type="<%- field.loadColumnType %>"/>
    <%_ } _%>
  <%_ } _%>
            <!-- jhipster-needle-liquibase-add-loadcolumn - JHipster (and/or extensions) can add load columns here -->
        </loadData>
    </changeSet>
<%_ } _%>
</databaseChangeLog>
