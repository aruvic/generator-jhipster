<%
    const hasMapperDependencies = Array.isArray(usesMappers) && usesMappers.length > 0;
    const requestVariants = variants.filter(variant => !variant.isBase);
-%>
/**
 * MapStruct helper mapper for the <%- baseType %> polymorphic family.
 * Provides @ObjectFactory hooks so MapStruct can instantiate concrete subtypes when resolving abstract references.
 */

package <%- packageName %>;

import org.mapstruct.Mapper;
import org.mapstruct.Named;
import org.mapstruct.ObjectFactory;
import org.mapstruct.ReportingPolicy;

@Mapper(
    componentModel = "spring",
    unmappedTargetPolicy = ReportingPolicy.IGNORE<%_ if (hasMapperDependencies) { _%>,
    uses = { <%- usesMappers.map(mapper => mapper + '.class').join(', ') %> }<%_ } _%>
)
public interface <%- mapperName %> {
    <%- baseDtoType %> to<%- baseType %>Dto(<%- baseDomainType %> source);

    @ObjectFactory
    default <%- baseDtoType %> create<%- baseType %>Dto(<%- baseDomainType %> source) {
        if (source == null) {
            return null;
        }
 <%_ for (const subtype of subtypes) { _%>
        if ((Object) source instanceof <%- subtype.domainType %>) {
            return new <%- subtype.dtoType %>();
        }
 <%_ } _%>
 <%_ if (isAbstract) { _%>
        return null;
 <%_ } else { _%>
        return new <%- baseDtoType %>();
 <%_ } _%>
    }

<%_ if (locals.baseMethodAnnotations) { _%>
<%_ for (const annotation of baseMethodAnnotations) { _%>
    <%- annotation %>
<%_ } _%>
<%_ } _%>
    <%- baseDomainType %> to<%- baseType %>(<%- baseDtoType %> source);

    default <%- baseDomainType %> to<%- baseType %>Entity(<%- baseDtoType %> source) {
        return to<%- baseType %>(source);
    }

    @ObjectFactory
    default <%- baseDomainType %> create<%- baseType %>(<%- baseDtoType %> source) {
        if (source == null) {
            return null;
        }
 <%_ for (const subtype of subtypes) { _%>
   <%_ if (subtype.isCompatible) { _%>
        if ((Object) source instanceof <%- subtype.dtoType %>) {
            return new <%- subtype.domainType %>();
        }
   <%_ } _%>
 <%_ } _%>
 <%_ if (isAbstract) { _%>
        return null;
 <%_ } else { _%>
        return new <%- baseDomainType %>();
 <%_ } _%>
    }

<%_ for (const variant of requestVariants) { const targetDomainType = variant.targetDomainType || baseDomainType; _%>
<%_ if (variant.annotations) { _%>
<%_ for (const annotation of variant.annotations) { _%>
    <%- annotation %>
<%_ } _%>
<%_ } _%>
    <%- targetDomainType %> <%- variant.mappingMethodName || `to${baseType}From${variant.dtoSimpleName}` %>(<%- variant.dtoType %> source);

    @ObjectFactory
    default <%- targetDomainType %> instantiate<%- baseType %>From<%- variant.dtoSimpleName %>(<%- variant.dtoType %> source) {
        if (source == null) {
            return null;
        }
<%_ 
        const effectiveSubtypes = (variant.subtypes && variant.subtypes.length > 0) ? variant.subtypes : subtypes;
        for (const subtype of effectiveSubtypes) {
            let subtypeDtoType = subtype.dtoType;
            if (!variant.subtypes || variant.subtypes.length === 0) {
                const variantSuffix = variant.dtoSimpleName.replace(baseType, '');
                if (variantSuffix) {
                    const subtypeBase = subtype.dtoSimpleName.replace(/DTO$/, '');
                    const packagePart = subtype.dtoType.substring(0, subtype.dtoType.lastIndexOf('.'));
                    subtypeDtoType = `${packagePart}.${subtypeBase}${variantSuffix}`;
                }
            }
_%>
    <%_ if (subtype.isCompatible) { _%>
        if ((Object) source instanceof <%- subtypeDtoType %>) {
            return new <%- subtype.domainType %>();
        }
    <%_ } _%>
<%_     } _%>
<%_     if (targetDomainType === baseDomainType && isAbstract) { _%>
        return null;
<%_     } else { _%>
        return new <%- targetDomainType %>();
<%_     } _%>
    }
<%_ } _%>
}
