/**
 * Shared MapStruct mapper for OpenAPI primitive and JsonNullable conversions.
 */

package <%- packageName %>;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import org.mapstruct.Mapper;
import org.mapstruct.Named;
import org.mapstruct.ObjectFactory;
import org.mapstruct.ReportingPolicy;
import org.openapitools.jackson.nullable.JsonNullable;

@Mapper(componentModel = "spring", unmappedTargetPolicy = ReportingPolicy.IGNORE)
public interface OpenApiPrimitiveMapper {
    default String map(Object value) {
        if (value == null) {
            return null;
        }
        if (value instanceof Map || value instanceof List) {
            return JsonMappingSupport.writeValueAsString(value);
        }
        return value.toString();
    }

    default String map(JsonNullable<?> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        final Object resolved = value.orElse(null);
        if (resolved == null) {
            return null;
        }
        if (resolved instanceof Map || resolved instanceof List) {
            return JsonMappingSupport.writeValueAsString(resolved);
        }
        return resolved.toString();
    }

    @Named("jsonStringToJsonNullableMap")
    default JsonNullable<Map<String, Object>> jsonStringToJsonNullableMap(String value) {
        if (value == null || value.isBlank()) {
            return JsonNullable.undefined();
        }
        return JsonNullable.of(JsonMappingSupport.readMap(value));
    }

    @Named("jsonStringToJsonNullableStringList")
    default JsonNullable<List<String>> jsonStringToJsonNullableStringList(String value) {
        if (value == null || value.isBlank()) {
            return JsonNullable.undefined();
        }
        return JsonNullable.of(JsonMappingSupport.readStringList(value));
    }

    @Named("jsonNullableMapToString")
    default String jsonNullableMapToString(JsonNullable<Map<String, Object>> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value.orElse(null));
    }

    @Named("jsonNullableStringListToString")
    default String jsonNullableStringListToString(JsonNullable<List<String>> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value.orElse(null));
    }

    @Named("jsonStringToMap")
    default Map<String, Object> jsonStringToMap(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyMap();
        }
        return JsonMappingSupport.readMap(value);
    }

    @Named("mapToJsonString")
    default String mapToJsonString(Object value) {
        if (value == null) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value);
    }

    @Named("jsonStringToStringList")
    default List<String> jsonStringToStringList(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyList();
        }
        return JsonMappingSupport.readStringList(value);
    }

    @Named("stringListToJsonString")
    default String stringListToJsonString(List<String> value) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value);
    }

    default <T> JsonNullable<T> toJsonNullable(T value) {
        return value != null ? JsonNullable.of(value) : JsonNullable.undefined();
    }

    default List<String> toStringList(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyList();
        }
        return Collections.singletonList(value);
    }

    default String fromStringList(List<String> value) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        return value.get(0);
    }

    @ObjectFactory
    default JsonNullable<Object> mapToJsonNullable(Object value) {
        return value != null ? JsonNullable.of(value) : JsonNullable.undefined();
    }

    final class JsonMappingSupport {
        private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper()
            .configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false)
            .configure(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS, false);

        private static final TypeReference<Map<String, Object>> MAP_TYPE = new TypeReference<>() {};
        private static final TypeReference<List<String>> STRING_LIST_TYPE = new TypeReference<>() {};

        private JsonMappingSupport() {}

        static Map<String, Object> readMap(String value) {
            try {
                return OBJECT_MAPPER.readValue(value, MAP_TYPE);
            } catch (JsonProcessingException ex) {
                throw new IllegalArgumentException("Unable to deserialize JSON to Map", ex);
            }
        }

        static List<String> readStringList(String value) {
            try {
                return OBJECT_MAPPER.readValue(value, STRING_LIST_TYPE);
            } catch (JsonProcessingException ex) {
                throw new IllegalArgumentException("Unable to deserialize JSON to List", ex);
            }
        }

        static String writeValueAsString(Object value) {
            if (value == null) {
                return null;
            }
            try {
                return OBJECT_MAPPER.writeValueAsString(value);
            } catch (JsonProcessingException ex) {
                throw new IllegalArgumentException("Unable to serialize value to JSON", ex);
            }
        }
    }
}
