/**
 * Shared MapStruct mapper for OpenAPI primitive and JsonNullable conversions.
 */

package <%- packageName %>;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import java.math.BigDecimal;
import java.util.Collections;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import org.mapstruct.Mapper;
import org.mapstruct.Named;
import org.mapstruct.ObjectFactory;
import org.mapstruct.ReportingPolicy;
import org.mapstruct.TargetType;
import org.springframework.context.annotation.Lazy;
import org.springframework.http.HttpStatus;
import org.springframework.web.server.ResponseStatusException;
import org.openapitools.jackson.nullable.JsonNullable;
import org.openapitools.jackson.nullable.JsonNullableModule;

@Lazy
@Mapper(componentModel = "spring", unmappedTargetPolicy = ReportingPolicy.IGNORE)
public interface OpenApiPrimitiveMapper {
    @Named("uriToString")
    default String uriToString(java.net.URI value) {
        return value == null ? null : value.toString();
    }

    @Named("stringToUri")
    default java.net.URI stringToUri(String value) {
        if (value == null || value.isBlank()) {
            return null;
        }
        return java.net.URI.create(value);
    }

    default String map(java.net.URI value) {
        return uriToString(value);
    }

    default java.net.URI mapStringToUri(String value) {
        return stringToUri(value);
    }

    default String map(Object value) {
        if (value == null) {
            return null;
        }
        if (value instanceof String stringValue) {
            return stringValue;
        }
        if (value instanceof JsonNullable<?> jsonNullable) {
            return map(jsonNullable);
        }
        if (value instanceof Enum<?> enumValue) {
            return enumValue.toString();
        }
        return JsonMappingSupport.writeValueAsString(value);
    }

    default String map(JsonNullable<?> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        final Object resolved = value.orElse(null);
        if (resolved instanceof String stringValue) {
            return stringValue;
        }
        if (resolved instanceof Enum<?> enumValue) {
            return enumValue.toString();
        }
        return JsonMappingSupport.writeValueAsString(resolved);
    }

    default Long jsonNullableToLong(JsonNullable<Long> value) {
        return unwrap(value);
    }

    default Integer jsonNullableToInteger(JsonNullable<Integer> value) {
        return unwrap(value);
    }

    default Double jsonNullableToDouble(JsonNullable<Double> value) {
        return unwrap(value);
    }

    default Float jsonNullableToFloat(JsonNullable<Float> value) {
        return unwrap(value);
    }

    default BigDecimal jsonNullableToBigDecimal(JsonNullable<BigDecimal> value) {
        return unwrap(value);
    }

    default Boolean jsonNullableToBoolean(JsonNullable<Boolean> value) {
        return unwrap(value);
    }

    private static <T> T unwrap(JsonNullable<T> value) {
        return value == null || !value.isPresent() ? null : value.orElse(null);
    }

    default <E extends Enum<E>> E map(Enum<?> value, @TargetType Class<E> targetType) {
        return mapEnumValue(value == null ? null : value.toString(), targetType);
    }

    default <E extends Enum<E>> E map(String value, @TargetType Class<E> targetType) {
        return mapEnumValue(value, targetType);
    }

    private static <E extends Enum<E>> E mapEnumValue(String value, Class<E> targetType) {
        if (value == null) {
            return null;
        }
        final String normalizedValue = normalizeEnumToken(value);
        for (E constant : targetType.getEnumConstants()) {
            if (
                constant.name().equals(value) ||
                constant.toString().equals(value) ||
                normalizeEnumToken(constant.name()).equals(normalizedValue) ||
                normalizeEnumToken(constant.toString()).equals(normalizedValue)
            ) {
                return constant;
            }
        }
        throw new IllegalArgumentException("No enum constant " + targetType.getName() + " for OpenAPI value " + value);
    }

    private static String normalizeEnumToken(String value) {
        String normalized = value.trim().toUpperCase(Locale.ROOT).replaceAll("[^A-Z0-9]+", "_").replaceAll("^_+|_+$", "");
        if (normalized.startsWith("VALUE_")) {
            normalized = normalized.substring("VALUE_".length());
        }
        return normalized;
    }

    default <E extends Enum<E>> List<E> enumToSingletonList(Object value, Class<E> targetType) {
        E mapped = value instanceof Enum<?> enumValue ? map(enumValue, targetType) : map(value == null ? null : value.toString(), targetType);
        return mapped == null ? null : Collections.singletonList(mapped);
    }

    default <E extends Enum<E>> E firstEnumFromList(List<?> value, Class<E> targetType) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        Object first = value.get(0);
        if (first instanceof Enum<?> enumValue) {
            return map(enumValue, targetType);
        }
        return map(first == null ? null : first.toString(), targetType);
    }

    default String firstTokenFromList(List<?> value) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        Object first = value.get(0);
        return first == null ? null : first.toString();
    }

    default <T> List<T> scalarToSingletonList(T value) {
        return value == null ? null : Collections.singletonList(value);
    }

    default <T> T firstFromList(List<T> value) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        return value.get(0);
    }

    @Named("jsonStringToJsonNullableMap")
    default JsonNullable<Map<String, Object>> jsonStringToJsonNullableMap(String value) {
        if (value == null || value.isBlank()) {
            return JsonNullable.undefined();
        }
        return JsonNullable.of(JsonMappingSupport.readMap(value));
    }

    @Named("jsonStringToJsonNullableStringList")
    default JsonNullable<List<String>> jsonStringToJsonNullableStringList(String value) {
        if (value == null || value.isBlank()) {
            return JsonNullable.undefined();
        }
        return JsonNullable.of(JsonMappingSupport.readStringList(value));
    }

    @Named("jsonStringToJsonNullableList")
    default <T> JsonNullable<List<T>> jsonStringToJsonNullableList(String value) {
        if (value == null || value.isBlank()) {
            return JsonNullable.undefined();
        }
        return JsonNullable.of(JsonMappingSupport.readList(value));
    }

    @Named("jsonStringToJsonNullableObject")
    default JsonNullable<Object> jsonStringToJsonNullableObject(String value) {
        if (value == null || value.isBlank()) {
            return JsonNullable.undefined();
        }
        return JsonNullable.of(JsonMappingSupport.readObject(value));
    }

    @Named("jsonNullableMapToString")
    default String jsonNullableMapToString(JsonNullable<Map<String, Object>> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value.orElse(null));
    }

    @Named("jsonNullableStringListToString")
    default String jsonNullableStringListToString(JsonNullable<List<String>> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value.orElse(null));
    }

    @Named("jsonNullableListToString")
    default String jsonNullableListToString(JsonNullable<? extends List<?>> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value.orElse(null));
    }

    @Named("jsonNullableObjectToString")
    default String jsonNullableObjectToString(JsonNullable<?> value) {
        if (value == null || !value.isPresent()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value.orElse(null));
    }

    @Named("jsonStringToMap")
    @SuppressWarnings("unchecked")
    default <T> Map<String, T> jsonStringToMap(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyMap();
        }
        return (Map<String, T>) JsonMappingSupport.readMap(value);
    }

    @Named("jsonStringToObject")
    default <T> T jsonStringToObject(String value, @TargetType Class<T> targetType) {
        if (value == null || value.isBlank()) {
            return null;
        }
        return JsonMappingSupport.readObject(value, targetType);
    }

    @Named("mapToJsonString")
    default String mapToJsonString(Object value) {
        if (value == null) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value);
    }

    @Named("objectToJsonString")
    default String objectToJsonString(Object value) {
        return mapToJsonString(value);
    }

    @Named("jsonStringToStringList")
    default List<String> jsonStringToStringList(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyList();
        }
        return JsonMappingSupport.readStringList(value);
    }

    @Named("jsonStringToList")
    default <T> List<T> jsonStringToList(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyList();
        }
        return JsonMappingSupport.readList(value);
    }

    @Named("stringListToJsonString")
    default String stringListToJsonString(List<String> value) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value);
    }

    @Named("listToJsonString")
    default String listToJsonString(Object value) {
        if (value == null) {
            return null;
        }
        if (value instanceof java.util.Collection<?> collection && collection.isEmpty()) {
            return null;
        }
        return JsonMappingSupport.writeValueAsString(value);
    }

    default <T> JsonNullable<T> toJsonNullable(T value) {
        return value != null ? JsonNullable.of(value) : JsonNullable.undefined();
    }

    default List<String> toStringList(String value) {
        if (value == null || value.isBlank()) {
            return Collections.emptyList();
        }
        return Collections.singletonList(value);
    }

    default String fromStringList(List<String> value) {
        if (value == null || value.isEmpty()) {
            return null;
        }
        return value.get(0);
    }

    @ObjectFactory
    default JsonNullable<Object> mapToJsonNullable(Object value) {
        return value != null ? JsonNullable.of(value) : JsonNullable.undefined();
    }

    final class JsonMappingSupport {
        private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper()
            .registerModule(new JavaTimeModule())
            .registerModule(new JsonNullableModule())
            .configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false)
            .configure(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS, false);

        private static final TypeReference<Map<String, Object>> MAP_TYPE = new TypeReference<>() {};
        private static final TypeReference<List<Object>> LIST_TYPE = new TypeReference<>() {};
        private static final TypeReference<List<String>> STRING_LIST_TYPE = new TypeReference<>() {};

        private JsonMappingSupport() {}

        static Map<String, Object> readMap(String value) {
            try {
                return OBJECT_MAPPER.readValue(value, MAP_TYPE);
            } catch (JsonProcessingException ex) {
                throw badRequest("Unable to deserialize JSON to Map", ex);
            }
        }

        static List<String> readStringList(String value) {
            try {
                return OBJECT_MAPPER.readValue(value, STRING_LIST_TYPE);
            } catch (JsonProcessingException ex) {
                throw badRequest("Unable to deserialize JSON to List", ex);
            }
        }

        @SuppressWarnings("unchecked")
        static <T> List<T> readList(String value) {
            try {
                return (List<T>) OBJECT_MAPPER.readValue(value, LIST_TYPE);
            } catch (JsonProcessingException ex) {
                throw badRequest("Unable to deserialize JSON to List", ex);
            }
        }

        static Object readObject(String value) {
            try {
                return OBJECT_MAPPER.readValue(value, Object.class);
            } catch (JsonProcessingException ex) {
                throw badRequest("Unable to deserialize JSON", ex);
            }
        }

        static <T> T readObject(String value, Class<T> targetType) {
            try {
                return OBJECT_MAPPER.readValue(value, targetType);
            } catch (JsonProcessingException ex) {
                throw badRequest("Unable to deserialize JSON to " + targetType.getSimpleName(), ex);
            }
        }

        static String writeValueAsString(Object value) {
            if (value == null) {
                return null;
            }
            try {
                return OBJECT_MAPPER.writeValueAsString(value);
            } catch (JsonProcessingException ex) {
                throw badRequest("Unable to serialize value to JSON", ex);
            }
        }

        private static ResponseStatusException badRequest(String message, Exception ex) {
            return new ResponseStatusException(HttpStatus.BAD_REQUEST, message, ex);
        }
    }
}
