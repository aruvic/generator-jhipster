package <%- packageName %>;

import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.mapstruct.Named;
import org.mapstruct.ObjectFactory;
import org.mapstruct.ReportingPolicy;
import org.mapstruct.SubclassMapping;
import org.mapstruct.SubclassExhaustiveStrategy;
import org.springframework.context.annotation.Lazy;

/**
 * MapStruct <%- direction === 'request' ? 'Request' : 'Response' %> Mapper.
 * Automatically generated from OpenAPI specification to handle <%- direction === 'request' ? 'DTO → Domain' : 'Domain → DTO' %> mappings.
 */
@Lazy
@Mapper(
    componentModel = "spring",
    unmappedTargetPolicy = ReportingPolicy.IGNORE,
    subclassExhaustiveStrategy = SubclassExhaustiveStrategy.COMPILE_ERROR
)
public interface <%- mapperName %> {

    // ========== Standard Mappings ==========
<%_ for (const mapping of mappings) { _%>
  <%_ if (mapping.annotations && mapping.annotations.length > 0) { _%>
    <%_ for (const annotation of mapping.annotations) { _%>
    <%- annotation %>
    <%_ } _%>
  <%_ } _%>
  <%_ if (direction === 'request') { _%>
    <%- mapping.domainType %> to<%- mapping.entityName %>(<%- mapping.dtoType %> source);
  <%_ } else { _%>
    <%- mapping.dtoType %> to<%- mapping.entityName %>Dto(<%- mapping.domainType %> source);
  <%_ } _%>

<%_ } _%>

    // ========== Polymorphic Mappings with @SubclassMapping ==========
<%_ for (const poly of polymorphicMappings) { _%>

    /**
     * Polymorphic mapping for <%- poly.baseType %>
     */
  <%_ for (const subtype of poly.subtypes) { _%>
    @SubclassMapping(source = <%- subtype.dtoSimpleName %>.class, target = <%- subtype.domainSimpleName %>.class)
  <%_ } _%>
  <%_ if (direction === 'request') { _%>
    <%- poly.baseDomainType %> to<%- poly.baseType %>(<%- poly.baseDtoType %> source);
  <%_ } else { _%>
    <%- poly.baseDtoType %> to<%- poly.baseType %>Dto(<%- poly.baseDomainType %> source);
  <%_ } _%>

    /**
     * Object factory for <%- poly.baseType %> polymorphic instantiation
     */
    @ObjectFactory
  <%_ if (direction === 'request') { _%>
    default <%- poly.baseDomainType %> create<%- poly.baseType %>(<%- poly.baseDtoType %> source) {
        if (source == null) return null;
    <%_ for (const subtype of poly.subtypes) { _%>
        if (source instanceof <%- subtype.dtoType %>) return new <%- subtype.domainType %>();
    <%_ } _%>
        return null;
    }
  <%_ } else { _%>
    default <%- poly.baseDtoType %> create<%- poly.baseType %>Dto(<%- poly.baseDomainType %> source) {
        if (source == null) return null;
    <%_ for (const subtype of poly.subtypes) { _%>
        if (source instanceof <%- subtype.domainType %>) return new <%- subtype.dtoType %>();
    <%_ } _%>
        return null;
    }
  <%_ } _%>

<%_ } _%>

    // ========== Custom Mapping Methods for Abstract Types ==========
<%_ for (const customMethod of customMethods) { _%>

    /**
     * Custom mapping for <%- customMethod.sourceType.split('.').pop() %> (abstract type)
     */
  <%_ if (direction === 'request') { _%>
    default <%- customMethod.targetType %> <%- customMethod.methodName %>(<%- customMethod.sourceType %> source) {
        if (source == null) return null;
    <%_ for (const subtype of customMethod.subtypes) { _%>
        if (source instanceof <%- subtype.dtoType %>) return to<%- subtype.domainSimpleName %>((<%- subtype.dtoType %>) source);
    <%_ } _%>
        return null;
    }
  <%_ } else { _%>
    default <%- customMethod.targetType %> <%- customMethod.methodName %>Dto(<%- customMethod.sourceType %> source) {
        if (source == null) return null;
    <%_ for (const subtype of customMethod.subtypes) { _%>
        if (source instanceof <%- subtype.domainType %>) return to<%- subtype.domainSimpleName %>Dto((<%- subtype.domainType %>) source);
    <%_ } _%>
        return null;
    }
  <%_ } _%>

<%_ } _%>
}
