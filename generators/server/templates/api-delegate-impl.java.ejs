        }
        if (normalized.contains("merge-patch")) {
            return PatchFormat.MERGE_PATCH;
        }
        if (patchNode != null && patchNode.isArray()) {
            return PatchFormat.JSON_PATCH;
        }
        return PatchFormat.MERGE_PATCH;
