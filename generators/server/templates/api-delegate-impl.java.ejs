        }
    }

    private void copyByNormalizedName(Object source, Object target, boolean skipNullValues, boolean overwriteExisting) {
        Map<String, Method> settersByName = new HashMap<>();
        Map<String, Method> gettersByName = new HashMap<>();

        for (Method method : target.getClass().getMethods()) {
            if (method.getParameterCount() == 1 && method.getName().startsWith("set")) {
                settersByName.put(normalizeName(method.getName().substring(3)), method);
            }
            if (method.getParameterCount() == 0 && (method.getName().startsWith("get") || method.getName().startsWith("is"))) {
                String base = method.getName().startsWith("is") ? method.getName().substring(2) : method.getName().substring(3);
                gettersByName.put(normalizeName(base), method);
            }
        }

        for (Method method : source.getClass().getMethods()) {
            if (method.getParameterCount() != 0) {
                continue;
            }
            if (!(method.getName().startsWith("get") || method.getName().startsWith("is"))) {
                continue;
            }
            if ("getClass".equals(method.getName())) {
                continue;
            }

            Object value;
            try {
                value = method.invoke(source);
            } catch (IllegalAccessException | InvocationTargetException ignored) {
                continue;
            }
            if (skipNullValues && value == null) {
                continue;
            }

            String baseName = method.getName().startsWith("is") ? method.getName().substring(2) : method.getName().substring(3);
            String normalized = normalizeName(baseName);
            Method setter = settersByName.get(normalized);
            if (setter == null) {
                continue;
            }

            if (!overwriteExisting) {
                Method targetGetter = gettersByName.get(normalized);
                if (targetGetter != null) {
                    try {
                        Object currentValue = targetGetter.invoke(target);
                        if (currentValue != null) {
                            continue;
                        }
                    } catch (IllegalAccessException | InvocationTargetException ignored) {
                        // Fall through to attempt copy.
                    }
                }
            }

            Class<?> paramType = setter.getParameterTypes()[0];
            if (value != null && !paramType.isAssignableFrom(value.getClass()) && !(paramType.isPrimitive())) {
                continue;
            }
            try {
                setter.invoke(target, value);
            } catch (IllegalAccessException | InvocationTargetException ignored) {
                // Skip properties without compatible setters.
            }
        }
    }

    private String normalizeName(String name) {
        return name == null ? "" : name.replaceAll("[^A-Za-z0-9]", "").toLowerCase();
