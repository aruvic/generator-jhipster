        for (JsonNode operation : patchOperations) {
            if (!(operation instanceof ObjectNode opObject)) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSON Patch operation must be an object");
            }
            if (!opObject.hasNonNull("op") || !opObject.has("path")) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSON Patch operation requires 'op' and 'path'");
            }
            ObjectNode copy = opObject.deepCopy();
            copy.put("path", resolvePatchPath(baseNode, opObject.get("path")));
            if (opObject.has("from")) {
                copy.put("from", resolvePatchPath(baseNode, opObject.get("from")));
            }
            translated.add(copy);
        }
        return translated;
    }

    private String resolvePatchPath(JsonNode baseNode, JsonNode rawPath) {
        if (rawPath == null || rawPath.isNull()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patch path is required");
        }
        final String path = rawPath.asText();
        if (path == null || path.isBlank()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patch path is required");
        }
        final boolean appendToArray = path.endsWith("/-");
        final String effectivePath = appendToArray ? path.substring(0, path.length() - 2) : path;
        String resolvedPath;
        if (effectivePath.startsWith("/")) {
            resolvedPath = effectivePath;
        } else {
            List<String> resolved = evaluateJsonPath(effectivePath, baseNode);
            if (resolved.isEmpty()) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSONPath did not match any nodes");
            }
            if (resolved.size() > 1) {
                throw new ResponseStatusException(HttpStatus.CONFLICT, "JSONPath matched multiple targets");
            }
            resolvedPath = resolved.get(0);
        }
        return appendToArray ? resolvedPath + "/-" : resolvedPath;
    }

    private List<String> evaluateJsonPath(String expression, JsonNode baseNode) {
        try {
            String normalizedExpression = normalizeJsonPathExpression(expression);
            List<String> paths = JsonPath
                .using(this.jsonPathConfiguration)
                .parse(baseNode)
                .read(normalizedExpression, new TypeRef<List<String>>() {});
            if (paths == null || paths.isEmpty()) {
                return List.of();
            }
            List<String> pointers = new ArrayList<>();
            for (String path : paths) {
                String pointer = convertJsonPathToPointer(path);
                if (pointer != null && !pointer.isBlank()) {
                    pointers.add(pointer);
                }
            }
            return pointers;
        } catch (PathNotFoundException ex) {
            return List.of();
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid JSONPath expression", ex);
        }
    }

    private String normalizeJsonPathExpression(String expression) {
        if (expression == null) {
            return "";
        }
        Matcher matcher = Pattern.compile("(==\\s*)([^'\"\\s\\]]+)").matcher(expression);
        StringBuffer buffer = new StringBuffer();
        while (matcher.find()) {
            String value = matcher.group(2);
            matcher.appendReplacement(buffer, matcher.group(1) + "'" + value + "'");
        }
        matcher.appendTail(buffer);
        return buffer.toString();
    }

    private String convertJsonPathToPointer(String jsonPath) {
        if (jsonPath == null || jsonPath.isBlank()) {
            return null;
        }
        final String trimmed = jsonPath.trim();
        if ("$".equals(trimmed)) {
            return "/";
        }
        final String normalized = trimmed.startsWith("$") ? trimmed.substring(1) : trimmed;
        List<String> segments = new ArrayList<>();
        int index = 0;
        while (index < normalized.length()) {
            char current = normalized.charAt(index);
            if (current == '.') {
                index++;
                int start = index;
                while (index < normalized.length() && normalized.charAt(index) != '.' && normalized.charAt(index) != '[') {
                    index++;
                }
                if (index > start) {
                    segments.add(normalized.substring(start, index));
                }
            } else if (current == '[') {
                index++;
                if (index < normalized.length() && (normalized.charAt(index) == '\'' || normalized.charAt(index) == '\"')) {
                    char quote = normalized.charAt(index++);
                    int start = index;
                    while (index < normalized.length() && normalized.charAt(index) != quote) {
                        index++;
                    }
                    if (index > start) {
                        segments.add(normalized.substring(start, index));
                    }
                    while (index < normalized.length() && normalized.charAt(index) != ']') {
                        index++;
                    }
                    index++;
                } else {
                    int start = index;
                    while (index < normalized.length() && normalized.charAt(index) != ']') {
                        index++;
                    }
                    if (index > start) {
                        segments.add(normalized.substring(start, index));
                    }
                    if (index < normalized.length()) {
                        index++;
                    }
                }
            } else {
                index++;
            }
        }
        if (segments.isEmpty()) {
            return null;
        }
        StringBuilder pointer = new StringBuilder();
        segments.forEach(segment -> pointer.append('/').append(escapePointerSegment(segment)));
        return pointer.length() == 0 ? "/" : pointer.toString();
    }

    private String escapePointerSegment(String segment) {
        return segment.replace("~", "~0").replace("/", "~1");
    }

    private String readCachedRequestBody() {
        return resolveCurrentHttpServletRequest().map(this::extractCachedBody).orElse("");
    }

    private Optional<HttpServletRequest> resolveCurrentHttpServletRequest() {
        Optional<HttpServletRequest> fromDelegate = getRequest()
            .map(request -> request.getNativeRequest(HttpServletRequest.class))
            .filter(HttpServletRequest.class::isInstance)
            .map(HttpServletRequest.class::cast);
        if (fromDelegate.isPresent()) {
            return fromDelegate;
        }
        return Optional.ofNullable(RequestContextHolder.getRequestAttributes())
            .filter(ServletRequestAttributes.class::isInstance)
            .map(ServletRequestAttributes.class::cast)
            .map(ServletRequestAttributes::getRequest);
    }

    private String extractCachedBody(HttpServletRequest request) {
        HttpServletRequest current = request;
        while (current instanceof HttpServletRequestWrapper wrapper && !(current instanceof ContentCachingRequestWrapper)) {
            current = (HttpServletRequest) wrapper.getRequest();
        }
        if (current instanceof ContentCachingRequestWrapper cachingRequest) {
            byte[] body = cachingRequest.getContentAsByteArray();
            if (body != null && body.length > 0) {
                return new String(body, StandardCharsets.UTF_8);
            }
        }
        return "";
    }

    private <T> T convertValue(Object source, Class<T> targetType) {
        try {
            return this.objectMapper.convertValue(source, targetType);
        } catch (IllegalArgumentException ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to map payload", ex);
        }
    }

    private <T> T convertAndValidate(JsonNode node, Class<T> payloadType) {
        try {
            T value = this.objectMapper.treeToValue(node, payloadType);
            validatePayload(value);
            return value;
        } catch (ResponseStatusException ex) {
            throw ex;
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to map patched payload", ex);
        }
    }

    private <T> void validatePayload(T payload) {
        if (payload == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patched payload is empty");
        }
        if (this.validator == null) {
            return;
        }
        Set<ConstraintViolation<T>> violations = this.validator.validate(payload);
        if (!violations.isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, buildValidationMessage(violations));
        }
    }

    private <T> String buildValidationMessage(Set<ConstraintViolation<T>> violations) {
        StringBuilder builder = new StringBuilder("Validation failed: ");
        boolean first = true;
        for (ConstraintViolation<T> violation : violations) {
            if (!first) {
                builder.append("; ");
            }
            builder.append(violation.getPropertyPath()).append(' ').append(violation.getMessage());
            first = false;
        }
        return builder.toString();
    }

    private void enforceImmutableIdentifiers(JsonNode original, JsonNode patched) {
        if (original == null || patched == null) {
            return;
        }
        enforceImmutableRecursive(original, patched, true);
    }

    private void enforceImmutableRecursive(JsonNode original, JsonNode patched, boolean isRoot) {
        if (original.isObject() && patched.isObject()) {
            JsonNode originalTmfId = original.get("tmfId");
            JsonNode patchedTmfId = patched.get("tmfId");
            if (!isNullOrMissing(originalTmfId) && !isNullOrMissing(patchedTmfId) && !originalTmfId.equals(patchedTmfId)) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Field 'tmfId' is immutable");
            }
            if (isRoot || isNullOrMissing(originalTmfId)) {
                JsonNode originalId = original.get("id");
                JsonNode patchedId = patched.get("id");
                if (!isNullOrMissing(originalId) && !isNullOrMissing(patchedId) && !originalId.equals(patchedId)) {
                    throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Field 'id' is immutable");
                }
            }
            original.fieldNames().forEachRemaining(field -> {
                if ("id".equals(field) || "tmfId".equals(field)) {
                    return;
                }
                JsonNode originalChild = original.get(field);
                JsonNode patchedChild = patched.get(field);
                if (originalChild != null && patchedChild != null) {
                    enforceImmutableRecursive(originalChild, patchedChild, false);
                }
            });
        } else if (original.isArray() && patched.isArray()) {
            Map<String, JsonNode> patchedByTmfId = new LinkedHashMap<>();
            Map<String, JsonNode> patchedById = new LinkedHashMap<>();
            patched.forEach(node -> {
                JsonNode tmfIdNode = node.get("tmfId");
                if (!isNullOrMissing(tmfIdNode)) {
                    patchedByTmfId.put(tmfIdNode.asText(), node);
                }
                JsonNode idNode = node.get("id");
                if (!isNullOrMissing(idNode)) {
                    patchedById.put(idNode.asText(), node);
                }
            });
            original.forEach(node -> {
                JsonNode match = null;
                JsonNode tmfIdNode = node.get("tmfId");
                if (!isNullOrMissing(tmfIdNode)) {
                    match = patchedByTmfId.get(tmfIdNode.asText());
                }
                if (match == null) {
                    JsonNode idNode = node.get("id");
                    if (!isNullOrMissing(idNode)) {
                        match = patchedById.get(idNode.asText());
                    }
                }
                if (match != null) {
                    enforceImmutableRecursive(node, match, false);
                }
            });
        }
    }

    private boolean isNullOrMissing(JsonNode node) {
        return node == null || node.isMissingNode() || node.isNull();
    }

    private <T> T filterFields(T value, Object fields, Class<T> targetType) {
        if (value == null || fields == null || targetType == null) {
            return value;
        }
        final String fieldString = fields.toString();
        if (fieldString == null || fieldString.isBlank()) {
            return value;
        }
        Set<String> requested = new LinkedHashSet<>();
        for (String token : fieldString.split(",")) {
            if (token != null && !token.isBlank()) {
                requested.add(token.trim());
            }
        }
        if (requested.isEmpty()) {
            return value;
        }
        if (!requested.contains("id")) {
            requested.add("id");
        }
        try {
            JsonNode node = this.objectMapper.valueToTree(value);
            if (node instanceof ObjectNode objectNode) {
                ObjectNode pruned = objectNode.deepCopy();
                pruned.retain(requested);
                return this.objectMapper.convertValue(pruned, targetType);
            }
            return value;
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to apply field filter", ex);
        }
    }

    private URI buildLocation(Object identifier) {
        Object idValue = identifier != null ? identifier : "";
        try {
            ServletUriComponentsBuilder builder = ServletUriComponentsBuilder.fromCurrentRequestUri();
            if (identifier == null) {
                return builder.build().toUri();
            }
            return builder.pathSegment(idValue.toString()).build().normalize().toUri();
        } catch (IllegalStateException ignored) {
            if (idValue == null || idValue.toString().isBlank()) {
                return URI.create(String.format("/%s", "<%= resolvedResourceSlug %>"));
            }
            return URI.create(String.format("/%s/%s", "<%= resolvedResourceSlug %>", idValue));
        }
    }

    private enum PatchFormat {
        MERGE_PATCH,
        JSON_PATCH,
        JSON_PATCH_QUERY
    }
}
