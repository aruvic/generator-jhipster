    private int resolveOffset(Object rawOffset) {
        if (rawOffset == null) {
            return 0;
        }
        if (rawOffset instanceof Number number) {
            return Math.max(0, number.intValue());
        }
        try {
            return Math.max(0, Integer.parseInt(rawOffset.toString()));
        } catch (NumberFormatException ex) {
            return 0;
        }
    }

    private int resolveLimit(Object rawLimit) {
        final int defaultLimit = 20;
        final int maxLimit = 200;
        if (rawLimit == null) {
            return defaultLimit;
        }
        int value;
        if (rawLimit instanceof Number number) {
            value = number.intValue();
        } else {
            try {
                value = Integer.parseInt(rawLimit.toString());
            } catch (NumberFormatException ex) {
                return defaultLimit;
            }
        }
        if (value <= 0) {
            return defaultLimit;
        }
        return Math.min(value, maxLimit);
    }

    private Optional<Long> parseId(Object rawId) {
        if (rawId == null) {
            return Optional.empty();
        }
        if (rawId instanceof Long) {
            return Optional.of((Long) rawId);
        }
        if (rawId instanceof Number) {
            return Optional.of(((Number) rawId).longValue());
        }
        try {
            return Optional.of(Long.parseLong(rawId.toString()));
        } catch (NumberFormatException ex) {
            return Optional.empty();
        }
    }

    private boolean isBlankIdentifier(Object rawIdentifier) {
        return rawIdentifier == null || rawIdentifier.toString().isBlank();
    }

    private <T> Optional<T> findByResourceIdentifier(
        JpaRepository<T, Long> repository,
        Object rawIdentifier,
        String parameterName,
        Class<T> entityType
    ) {
        Optional<Long> parsedId = parseId(rawIdentifier);
        if (parsedId.isPresent()) {
            try {
                Optional<T> byId = repository.findById(parsedId.orElseThrow());
                if (byId.isPresent()) {
                    return byId;
                }
            } catch (RuntimeException ex) {
                LOG.debug("Unable to resolve {} by numeric identifier {}", entityType.getSimpleName(), rawIdentifier, ex);
            }
        }
        if (isBlankIdentifier(rawIdentifier)) {
            return Optional.empty();
        }
        String identifier = rawIdentifier.toString();
        List<Method> getters = identifierGetters(entityType, parameterName);
        if (getters.isEmpty()) {
            return Optional.empty();
        }
        try {
            return repository
                .findAll()
                .stream()
                .filter(entity -> getters.stream().anyMatch(getter -> identifierMatches(entity, getter, identifier)))
                .findFirst();
        } catch (RuntimeException ex) {
            LOG.debug("Unable to scan {} for resource identifier {}", entityType.getSimpleName(), rawIdentifier, ex);
            return Optional.empty();
        }
    }

    private List<Method> identifierGetters(Class<?> entityType, String parameterName) {
        List<Method> getters = new ArrayList<>();
        for (Method method : entityType.getMethods()) {
            if (identifierGetterScore(method, parameterName) > 0) {
                getters.add(method);
            }
        }
        getters.sort(Comparator.comparingInt((Method method) -> identifierGetterScore(method, parameterName)).reversed());
        return getters;
    }

    private int identifierGetterScore(Method method, String parameterName) {
        if (method.getParameterCount() != 0 || method.getName().equals("getClass") || !method.getName().startsWith("get")) {
            return 0;
        }
        if (!isScalarIdentifierType(method.getReturnType())) {
            return 0;
        }
        String propertyName = getterPropertyName(method);
        String normalizedProperty = normalizeIdentifierName(propertyName);
        String normalizedParameter = normalizeIdentifierName(parameterName);
        if (normalizedProperty.isBlank() || normalizedParameter.isBlank()) {
            return 0;
        }
        if (normalizedProperty.equals(normalizedParameter)) {
            return 100;
        }
        if (normalizedProperty.endsWith(normalizedParameter)) {
            return 90;
        }
        if (identifierTokensCompatible(propertyName, parameterName)) {
            return 80;
        }
        if (normalizedProperty.equals("id") && normalizedParameter.endsWith("id")) {
            return 70;
        }
        if (normalizedProperty.endsWith("id") && normalizedParameter.endsWith("id")) {
            return 60;
        }
        if (normalizedProperty.endsWith("reference") && normalizedParameter.endsWith("reference")) {
            return 50;
        }
        return 0;
    }

    private boolean identifierTokensCompatible(String propertyName, String parameterName) {
        List<String> propertyTokens = nameTokens(propertyName);
        List<String> parameterTokens = nameTokens(parameterName);
        return (
            parameterTokens.size() > 1 &&
            !propertyTokens.isEmpty() &&
            propertyTokens.get(propertyTokens.size() - 1).equals(parameterTokens.get(parameterTokens.size() - 1)) &&
            propertyTokens.containsAll(parameterTokens)
        );
    }

    private List<String> nameTokens(String value) {
        String separated = value
            .replaceAll("([a-z0-9])([A-Z])", "$1 $2")
            .replaceAll("([A-Z]+)([A-Z][a-z])", "$1 $2");
        List<String> tokens = new ArrayList<>();
        for (String token : separated.split("[^A-Za-z0-9]+")) {
            String normalized = normalizeIdentifierName(token);
            if (!normalized.isBlank()) {
                tokens.add(normalized);
            }
        }
        return tokens;
    }

    private boolean identifierMatches(Object entity, Method getter, String identifier) {
        try {
            Object value = getter.invoke(entity);
            return value != null && identifier.equals(value.toString());
        } catch (ReflectiveOperationException ex) {
            return false;
        }
    }

    private boolean isScalarIdentifierType(Class<?> type) {
        return (
            type.isPrimitive() ||
            CharSequence.class.isAssignableFrom(type) ||
            Number.class.isAssignableFrom(type) ||
            Boolean.class.isAssignableFrom(type) ||
            Character.class.isAssignableFrom(type) ||
            java.util.UUID.class.isAssignableFrom(type) ||
            type.isEnum() ||
            type.getName().startsWith("java.time.")
        );
    }

    private String getterPropertyName(Method method) {
        String name = method.getName().substring(3);
        if (name.length() <= 1) {
            return name.toLowerCase();
        }
        return Character.toLowerCase(name.charAt(0)) + name.substring(1);
    }

    private String normalizeIdentifierName(String value) {
        return value == null ? "" : value.replaceAll("[^A-Za-z0-9]", "").toLowerCase();
    }

    private HttpStatus resolveSuccessStatus(Integer statusCode, HttpStatus fallback) {
        if (statusCode == null) {
            return fallback;
        }
        try {
            return HttpStatus.valueOf(statusCode);
        } catch (IllegalArgumentException ignored) {
            return fallback;
        }
    }

    private String resolveContentType() {
        return resolveCurrentHttpServletRequest().map(HttpServletRequest::getContentType).orElse("");
    }

    private JsonNode readPatchNode(Object incomingPayload) {
        final String rawBody = readCachedRequestBody();
        if (rawBody != null && !rawBody.isBlank()) {
            try {
                return this.objectMapper.readTree(rawBody);
            } catch (Exception ex) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to parse patch payload", ex);
            }
        }
        if (incomingPayload == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patch payload is required");
        }
        try {
            return this.objectMapper.valueToTree(incomingPayload);
        } catch (IllegalArgumentException ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid patch payload", ex);
        }
    }

    private <T> JsonNode toJsonObject(T value) {
        if (value == null) {
            return this.objectMapper.createObjectNode();
        }
        JsonNode node = this.objectMapper.valueToTree(value);
        if (node == null || node.isMissingNode()) {
            return this.objectMapper.createObjectNode();
        }
        return node;
    }

    private JsonNode toJsonObject(Supplier<?> supplier) {
        try {
            return toJsonObject(supplier.get());
        } catch (ResponseStatusException ex) {
            throw ex;
        } catch (RuntimeException ex) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Resource not found", ex);
        }
    }

    private JsonNode normalizePatchDiscriminators(JsonNode node) {
        if (node instanceof ObjectNode objectNode) {
            JsonNode typeNode = objectNode.get("@type");
            if (typeNode != null && typeNode.isTextual()) {
                String normalizedType = normalizeDtoRoleDiscriminator(typeNode.asText());
                if (!normalizedType.equals(typeNode.asText())) {
                    objectNode.put("@type", normalizedType);
                }
            }
            Iterator<JsonNode> children = objectNode.elements();
            while (children.hasNext()) {
                normalizePatchDiscriminators(children.next());
            }
        } else if (node instanceof ArrayNode arrayNode) {
            for (JsonNode child : arrayNode) {
                normalizePatchDiscriminators(child);
            }
        }
        return node;
    }

    private String normalizeDtoRoleDiscriminator(String value) {
        return value != null ? value.replaceFirst("_(?:FVO|MVO|RES)$", "") : "";
    }

    private PatchFormat resolvePatchFormat(String contentType, JsonNode patchNode) {
        final String normalized = contentType != null ? contentType.toLowerCase() : "";
        if (normalized.contains("json-patch-query")) {
            return PatchFormat.JSON_PATCH_QUERY;
        }
        if (normalized.contains("json-patch")) {
            return PatchFormat.JSON_PATCH;
        }
        if (normalized.contains("merge-patch")) {
            return PatchFormat.MERGE_PATCH;
        }
        if (patchNode != null && patchNode.isArray()) {
            return PatchFormat.JSON_PATCH;
        }
        return PatchFormat.MERGE_PATCH;
    }

    private JsonNode applyPatchedNode(JsonNode baseNode, JsonNode patchNode, PatchFormat format) {
        if (format == PatchFormat.JSON_PATCH_QUERY) {
            if (!(patchNode instanceof ArrayNode patchArray)) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSON Patch payload must be an array");
            }
            return applyJsonPatchQuery(baseNode, patchArray);
        }
        if (format == PatchFormat.JSON_PATCH) {
            if (!(patchNode instanceof ArrayNode patchArray)) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSON Patch payload must be an array");
            }
            return applyStandardJsonPatch(baseNode, patchArray);
        }
        return applyMergePatch(baseNode, patchNode);
    }

    private JsonNode pruneUnpatchedComplexFields(JsonNode patchedNode, JsonNode patchNode, PatchFormat format) {
        if (!(patchedNode instanceof ObjectNode patchedObject)) {
            return patchedNode;
        }
        if (replacesWholeDocument(patchNode, format)) {
            return patchedNode;
        }
        Set<String> patchedFields = topLevelPatchedFields(patchNode, format);
        ObjectNode mappingNode = patchedObject.deepCopy();
        List<String> fieldsToRemove = new ArrayList<>();
        Iterator<Map.Entry<String, JsonNode>> fields = mappingNode.fields();
        while (fields.hasNext()) {
            Map.Entry<String, JsonNode> entry = fields.next();
            if (!patchedFields.contains(entry.getKey()) && isComplexPatchField(entry.getValue())) {
                fieldsToRemove.add(entry.getKey());
            }
        }
        fieldsToRemove.forEach(mappingNode::remove);
        return mappingNode;
    }

    private boolean isComplexPatchField(JsonNode node) {
        return node != null && (node.isObject() || node.isArray());
    }

    private boolean replacesWholeDocument(JsonNode patchNode, PatchFormat format) {
        if (format == PatchFormat.MERGE_PATCH) {
            return patchNode != null && !patchNode.isObject();
        }
        if (!(patchNode instanceof ArrayNode patchArray)) {
            return false;
        }
        for (JsonNode operation : patchArray) {
            JsonNode path = operation.get("path");
            if (path != null && path.isTextual() && path.asText().isEmpty()) {
                return true;
            }
        }
        return false;
    }

    private Set<String> topLevelPatchedFields(JsonNode patchNode, PatchFormat format) {
        Set<String> fields = new LinkedHashSet<>();
        if (format == PatchFormat.MERGE_PATCH) {
            if (patchNode instanceof ObjectNode patchObject) {
                patchObject.fieldNames().forEachRemaining(fields::add);
            }
            return fields;
        }
        if (patchNode instanceof ArrayNode patchArray) {
            for (JsonNode operation : patchArray) {
                JsonNode path = operation.get("path");
                if (path != null && path.isTextual()) {
                    String field = topLevelJsonPointerField(path.asText());
                    if (!field.isBlank()) {
                        fields.add(field);
                    }
                }
            }
        }
        return fields;
    }

    private String topLevelJsonPointerField(String pointer) {
        if (pointer == null || pointer.isBlank() || !pointer.startsWith("/")) {
            return "";
        }
        int nextSlash = pointer.indexOf('/', 1);
        String encoded = nextSlash >= 0 ? pointer.substring(1, nextSlash) : pointer.substring(1);
        return decodeJsonPointerSegment(encoded);
    }

    private String decodeJsonPointerSegment(String segment) {
        return segment.replace("~1", "/").replace("~0", "~");
    }

    private JsonNode applyMergePatch(JsonNode baseNode, JsonNode patchNode) {
        try {
            JsonMergePatch mergePatch = JsonMergePatch.fromJson(patchNode != null ? patchNode : NullNode.instance);
            JsonNode target = baseNode != null ? baseNode : this.objectMapper.createObjectNode();
            return mergePatch.apply(target);
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to apply merge patch", ex);
        }
    }

    private JsonNode applyStandardJsonPatch(JsonNode baseNode, ArrayNode patchNode) {
        try {
            JsonPatch jsonPatch = JsonPatch.fromJson(patchNode);
            JsonNode target = baseNode != null ? baseNode : this.objectMapper.createObjectNode();
            return jsonPatch.apply(target);
        } catch (JsonPatchException ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to apply JSON Patch", ex);
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid JSON Patch payload", ex);
        }
    }

    private JsonNode applyJsonPatchQuery(JsonNode baseNode, ArrayNode patchOperations) {
        ArrayNode translated = translateJsonPatchQuery(baseNode, patchOperations);
        return applyStandardJsonPatch(baseNode, translated);
    }

    private ArrayNode translateJsonPatchQuery(JsonNode baseNode, ArrayNode patchOperations) {
        ArrayNode translated = this.objectMapper.createArrayNode();
        for (JsonNode operation : patchOperations) {
            if (!(operation instanceof ObjectNode opObject)) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSON Patch operation must be an object");
            }
            if (!opObject.hasNonNull("op") || !opObject.has("path")) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSON Patch operation requires 'op' and 'path'");
            }
            ObjectNode copy = opObject.deepCopy();
            copy.put("path", resolvePatchPath(baseNode, opObject.get("path")));
            if (opObject.has("from")) {
                copy.put("from", resolvePatchPath(baseNode, opObject.get("from")));
            }
            translated.add(copy);
        }
        return translated;
    }

    private String resolvePatchPath(JsonNode baseNode, JsonNode rawPath) {
        if (rawPath == null || rawPath.isNull()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patch path is required");
        }
        final String path = rawPath.asText();
        if (path == null || path.isBlank()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patch path is required");
        }
        final boolean appendToArray = path.endsWith("/-");
        final String effectivePath = appendToArray ? path.substring(0, path.length() - 2) : path;
        String resolvedPath;
        if (effectivePath.startsWith("/")) {
            resolvedPath = effectivePath;
        } else {
            List<String> resolved = evaluateJsonPath(effectivePath, baseNode);
            if (resolved.isEmpty()) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "JSONPath did not match any nodes");
            }
            if (resolved.size() > 1) {
                throw new ResponseStatusException(HttpStatus.CONFLICT, "JSONPath matched multiple targets");
            }
            resolvedPath = resolved.get(0);
        }
        return appendToArray ? resolvedPath + "/-" : resolvedPath;
    }

    private List<String> evaluateJsonPath(String expression, JsonNode baseNode) {
        try {
            String normalizedExpression = normalizeJsonPathExpression(expression);
            List<String> paths = JsonPath
                .using(this.jsonPathConfiguration)
                .parse(baseNode)
                .read(normalizedExpression, new TypeRef<List<String>>() {});
            if (paths == null || paths.isEmpty()) {
                return List.of();
            }
            List<String> pointers = new ArrayList<>();
            for (String path : paths) {
                String pointer = convertJsonPathToPointer(path);
                if (pointer != null && !pointer.isBlank()) {
                    pointers.add(pointer);
                }
            }
            return pointers;
        } catch (PathNotFoundException ex) {
            return List.of();
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid JSONPath expression", ex);
        }
    }

    private String normalizeJsonPathExpression(String expression) {
        if (expression == null) {
            return "";
        }
        Matcher matcher = Pattern.compile("(==\\s*)([^'\"\\s\\]]+)").matcher(expression);
        StringBuffer buffer = new StringBuffer();
        while (matcher.find()) {
            String value = matcher.group(2);
            matcher.appendReplacement(buffer, matcher.group(1) + "'" + value + "'");
        }
        matcher.appendTail(buffer);
        return buffer.toString();
    }

    private String convertJsonPathToPointer(String jsonPath) {
        if (jsonPath == null || jsonPath.isBlank()) {
            return null;
        }
        final String trimmed = jsonPath.trim();
        if ("$".equals(trimmed)) {
            return "/";
        }
        final String normalized = trimmed.startsWith("$") ? trimmed.substring(1) : trimmed;
        List<String> segments = new ArrayList<>();
        int index = 0;
        while (index < normalized.length()) {
            char current = normalized.charAt(index);
            if (current == '.') {
                index++;
                int start = index;
                while (index < normalized.length() && normalized.charAt(index) != '.' && normalized.charAt(index) != '[') {
                    index++;
                }
                if (index > start) {
                    segments.add(normalized.substring(start, index));
                }
            } else if (current == '[') {
                index++;
                if (index < normalized.length() && (normalized.charAt(index) == '\'' || normalized.charAt(index) == '\"')) {
                    char quote = normalized.charAt(index++);
                    int start = index;
                    while (index < normalized.length() && normalized.charAt(index) != quote) {
                        index++;
                    }
                    if (index > start) {
                        segments.add(normalized.substring(start, index));
                    }
                    while (index < normalized.length() && normalized.charAt(index) != ']') {
                        index++;
                    }
                    index++;
                } else {
                    int start = index;
                    while (index < normalized.length() && normalized.charAt(index) != ']') {
                        index++;
                    }
                    if (index > start) {
                        segments.add(normalized.substring(start, index));
                    }
                    if (index < normalized.length()) {
                        index++;
                    }
                }
            } else {
                index++;
            }
        }
        if (segments.isEmpty()) {
            return null;
        }
        StringBuilder pointer = new StringBuilder();
        segments.forEach(segment -> pointer.append('/').append(escapePointerSegment(segment)));
        return pointer.length() == 0 ? "/" : pointer.toString();
    }

    private String escapePointerSegment(String segment) {
        return segment.replace("~", "~0").replace("/", "~1");
    }

    private String readCachedRequestBody() {
        return resolveCurrentHttpServletRequest().map(this::extractCachedBody).orElse("");
    }

    private Optional<HttpServletRequest> resolveCurrentHttpServletRequest() {
        Optional<HttpServletRequest> fromDelegate = getRequest()
            .map(request -> request.getNativeRequest(HttpServletRequest.class))
            .filter(HttpServletRequest.class::isInstance)
            .map(HttpServletRequest.class::cast);
        if (fromDelegate.isPresent()) {
            return fromDelegate;
        }
        return Optional.ofNullable(RequestContextHolder.getRequestAttributes())
            .filter(ServletRequestAttributes.class::isInstance)
            .map(ServletRequestAttributes.class::cast)
            .map(ServletRequestAttributes::getRequest);
    }

    private String extractCachedBody(HttpServletRequest request) {
        HttpServletRequest current = request;
        while (current instanceof HttpServletRequestWrapper wrapper && !(current instanceof ContentCachingRequestWrapper)) {
            current = (HttpServletRequest) wrapper.getRequest();
        }
        if (current instanceof ContentCachingRequestWrapper cachingRequest) {
            byte[] body = cachingRequest.getContentAsByteArray();
            if (body != null && body.length > 0) {
                return new String(body, StandardCharsets.UTF_8);
            }
        }
        return "";
    }

    private <T> T convertValue(Object source, Class<T> targetType) {
        try {
            return this.objectMapper.convertValue(source, targetType);
        } catch (IllegalArgumentException ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to map payload", ex);
        }
    }

    private <T> T convertAndValidate(JsonNode node, Class<T> payloadType) {
        try {
            T value = this.objectMapper.treeToValue(node, payloadType);
            validatePayload(value);
            return value;
        } catch (ResponseStatusException ex) {
            throw ex;
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to map patched payload", ex);
        }
    }

    private <T> void validatePayload(T payload) {
        if (payload == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patched payload is empty");
        }
        if (this.validator == null) {
            return;
        }
        Set<ConstraintViolation<T>> violations = this.validator.validate(payload);
        if (!violations.isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, buildValidationMessage(violations));
        }
        if (hasStrictOpenApiEmailViolation(payload)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Validation failed: email must be a well-formed email address");
        }
    }

    private void validatePayloadDiscriminators(Object payload, List<DiscriminatorRule> rules) {
        if (!hasValidDiscriminators(payload, rules)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Payload discriminator value is not allowed by the OpenAPI schema");
        }
    }

    private ResponseStatusException persistenceViolation(RuntimeException ex) {
        return new ResponseStatusException(HttpStatus.BAD_REQUEST, "Payload violates persistence constraints", ex);
    }

    private <T> boolean isValidResponseBody(T body) {
        if (body == null || this.validator == null) {
            return true;
        }
        Set<ConstraintViolation<T>> violations;
        try {
            violations = this.validator.validate(body);
        } catch (RuntimeException ex) {
            LOG.debug("Skipping response body that could not be validated", ex);
            return false;
        }
        if (violations.isEmpty()) {
            if (hasStrictOpenApiEmailViolation(body)) {
                LOG.debug("Skipping schema-invalid response body: email must be a well-formed email address");
                return false;
            }
            if (!canSerializeResponseBody(body)) {
                return false;
            }
            return true;
        }
        LOG.debug("Skipping schema-invalid response body: {}", buildValidationMessage(violations));
        return false;
    }

    private boolean canSerializeResponseBody(Object body) {
        try {
            this.objectMapper.writeValueAsBytes(body);
            return true;
        } catch (Exception ex) {
            LOG.debug("Skipping response body that could not be serialized", ex);
            return false;
        }
    }

    private <T> T requireValidResponseDiscriminators(T body, List<DiscriminatorRule> rules) {
        if (!hasValidDiscriminators(body, rules)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Resource not found");
        }
        return body;
    }

    private <T> List<T> filterValidResponseDiscriminators(List<T> bodies, List<DiscriminatorRule> rules) {
        if (bodies == null || bodies.isEmpty() || rules == null || rules.isEmpty()) {
            return bodies;
        }
        return bodies.stream()
            .filter(body -> {
                boolean valid = hasValidDiscriminators(body, rules);
                if (!valid) {
                    LOG.debug("Skipping response body with an OpenAPI-invalid discriminator value");
                }
                return valid;
            })
            .toList();
    }

    private boolean hasValidDiscriminators(Object payload, List<DiscriminatorRule> rules) {
        if (payload == null || rules == null || rules.isEmpty()) {
            return true;
        }
        JsonNode node;
        try {
            node = this.objectMapper.valueToTree(payload);
        } catch (IllegalArgumentException ex) {
            return false;
        }
        for (DiscriminatorRule rule : rules) {
            if (rule == null || rule.propertyName() == null || rule.allowedValues() == null || rule.allowedValues().isEmpty()) {
                continue;
            }
            for (JsonNode target : discriminatorTargets(node, rule.pointer())) {
                if (!(target instanceof ObjectNode objectNode)) {
                    continue;
                }
                JsonNode value = objectNode.get(rule.propertyName());
                if (isNullOrMissing(value)) {
                    continue;
                }
                if (!isAllowedDiscriminatorValue(value, rule.allowedValues())) {
                    return false;
                }
            }
        }
        return true;
    }

    private boolean isAllowedDiscriminatorValue(JsonNode value, Set<String> allowedValues) {
        return value != null && value.isValueNode() && allowedValues.contains(value.asText());
    }

    private List<JsonNode> discriminatorTargets(JsonNode root, String pointer) {
        List<JsonNode> current = new ArrayList<>();
        if (root == null || root.isMissingNode()) {
            return current;
        }
        current.add(root);
        if (pointer == null || pointer.isBlank()) {
            return current;
        }
        String[] segments = pointer.split("/");
        for (String rawSegment : segments) {
            if (rawSegment.isEmpty()) {
                continue;
            }
            String segment = rawSegment.replace("~1", "/").replace("~0", "~");
            List<JsonNode> next = new ArrayList<>();
            for (JsonNode candidate : current) {
                if ("*".equals(segment)) {
                    if (candidate.isArray() || candidate.isObject()) {
                        candidate.elements().forEachRemaining(next::add);
                    }
                } else if (candidate.isObject()) {
                    JsonNode child = candidate.get(segment);
                    if (!isNullOrMissing(child)) {
                        next.add(child);
                    }
                } else if (candidate.isArray() && segment.matches("\\d+")) {
                    JsonNode child = candidate.get(Integer.parseInt(segment));
                    if (!isNullOrMissing(child)) {
                        next.add(child);
                    }
                }
            }
            if (next.isEmpty()) {
                return next;
            }
            current = next;
        }
        return current;
    }

    private <S, T> List<T> mapValidResponseBodies(List<S> sources, Function<S, T> mapper) {
        return sources.stream()
            .map(source -> {
                try {
                    T body = mapper.apply(source);
                    return isValidResponseBody(body) ? body : null;
                } catch (RuntimeException ex) {
                    LOG.debug("Skipping response body that could not be mapped", ex);
                    return null;
                }
            })
            .filter(java.util.Objects::nonNull)
            .toList();
    }

    private <T> T mapResponseBody(Supplier<T> mapper) {
        try {
            T body = mapper.get();
            requireValidResponseBody(body);
            return body;
        } catch (ResponseStatusException ex) {
            throw ex;
        } catch (RuntimeException ex) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Resource not found", ex);
        }
    }

    private <T> void requireValidResponseBody(T body) {
        if (!isValidResponseBody(body)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Resource not found");
        }
    }

    private boolean hasStrictOpenApiEmailViolation(Object value) {
        return hasStrictOpenApiEmailViolation(value, java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>()));
    }

    private boolean hasStrictOpenApiEmailViolation(Object value, Set<Object> visited) {
        Object unwrapped = unwrapJsonNullable(value);
        if (unwrapped == null) {
            return false;
        }
        if (unwrapped instanceof Iterable<?> iterable) {
            for (Object item : iterable) {
                if (hasStrictOpenApiEmailViolation(item, visited)) {
                    return true;
                }
            }
            return false;
        }
        if (unwrapped instanceof Map<?, ?> map) {
            for (Object item : map.values()) {
                if (hasStrictOpenApiEmailViolation(item, visited)) {
                    return true;
                }
            }
            return false;
        }
        Class<?> type = unwrapped.getClass();
        if (type.isArray()) {
            int length = java.lang.reflect.Array.getLength(unwrapped);
            for (int index = 0; index < length; index++) {
                if (hasStrictOpenApiEmailViolation(java.lang.reflect.Array.get(unwrapped, index), visited)) {
                    return true;
                }
            }
            return false;
        }
        if (!isOpenApiDtoType(type) || !visited.add(unwrapped)) {
            return false;
        }
        for (Method method : type.getMethods()) {
            if (!isBeanGetter(method)) {
                continue;
            }
            Object nested = invokeGetter(unwrapped, method);
            Object nestedValue = unwrapJsonNullable(nested);
            if (hasEmailAnnotation(method) && isBlankEmailValue(nestedValue)) {
                return true;
            }
            if (hasStrictOpenApiEmailViolation(nestedValue, visited)) {
                return true;
            }
        }
        return false;
    }

    private boolean isOpenApiDtoType(Class<?> type) {
        Package typePackage = type.getPackage();
        if (typePackage == null) {
            return false;
        }
        String packageName = typePackage.getName();
        return packageName.startsWith("<%= basePackage %>.service.api.dto");
    }

    private boolean isBeanGetter(Method method) {
        if (method.getParameterCount() != 0 || method.getDeclaringClass() == Object.class) {
            return false;
        }
        String name = method.getName();
        return (name.startsWith("get") && name.length() > 3) || (name.startsWith("is") && name.length() > 2);
    }

    private Object invokeGetter(Object target, Method method) {
        try {
            return method.invoke(target);
        } catch (ReflectiveOperationException | RuntimeException ex) {
            LOG.debug("Skipping OpenAPI DTO getter that could not be read", ex);
            return null;
        }
    }

    private boolean hasEmailAnnotation(Method method) {
        for (java.lang.annotation.Annotation annotation : method.getAnnotations()) {
            if ("jakarta.validation.constraints.Email".equals(annotation.annotationType().getName())) {
                return true;
            }
        }
        for (java.lang.annotation.Annotation annotation : method.getAnnotatedReturnType().getAnnotations()) {
            if ("jakarta.validation.constraints.Email".equals(annotation.annotationType().getName())) {
                return true;
            }
        }
        return false;
    }

    private boolean isBlankEmailValue(Object value) {
        return value instanceof CharSequence text && text.toString().isBlank();
    }

    private Object unwrapJsonNullable(Object value) {
        if (value == null || !"org.openapitools.jackson.nullable.JsonNullable".equals(value.getClass().getName())) {
            return value;
        }
        try {
            Method isPresent = value.getClass().getMethod("isPresent");
            if (!Boolean.TRUE.equals(isPresent.invoke(value))) {
                return null;
            }
            return value.getClass().getMethod("get").invoke(value);
        } catch (ReflectiveOperationException | RuntimeException ex) {
            LOG.debug("Unable to inspect JsonNullable value for validation", ex);
            return null;
        }
    }

    private <T> String buildValidationMessage(Set<ConstraintViolation<T>> violations) {
        StringBuilder builder = new StringBuilder("Validation failed: ");
        boolean first = true;
        for (ConstraintViolation<T> violation : violations) {
            if (!first) {
                builder.append("; ");
            }
            builder.append(violation.getPropertyPath()).append(' ').append(violation.getMessage());
            first = false;
        }
        return builder.toString();
    }

    private void enforceImmutableIdentifiers(JsonNode original, JsonNode patched) {
        if (original == null || patched == null) {
            return;
        }
        enforceImmutableRecursive(original, patched, true);
    }

    private void enforceImmutableRecursive(JsonNode original, JsonNode patched, boolean isRoot) {
        if (original.isObject() && patched.isObject()) {
            original.fieldNames().forEachRemaining(field -> {
                JsonNode originalChild = original.get(field);
                JsonNode patchedChild = patched.get(field);
                if (isIdentifierField(field)) {
                    if (!isNullOrMissing(originalChild) && !isNullOrMissing(patchedChild) && !originalChild.equals(patchedChild)) {
                        throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Field '" + field + "' is immutable");
                    }
                    return;
                }
                if (originalChild != null && patchedChild != null) {
                    enforceImmutableRecursive(originalChild, patchedChild, false);
                }
            });
        } else if (original.isArray() && patched.isArray()) {
            Map<String, JsonNode> patchedByIdentifier = new LinkedHashMap<>();
            patched.forEach(node -> {
                if (node != null && node.isObject()) {
                    node.fieldNames().forEachRemaining(field -> {
                        if (isIdentifierField(field)) {
                            JsonNode identifierNode = node.get(field);
                            if (!isNullOrMissing(identifierNode)) {
                                patchedByIdentifier.put(identifierKey(field, identifierNode), node);
                            }
                        }
                    });
                }
            });
            original.forEach(node -> {
                JsonNode match = null;
                if (node != null && node.isObject()) {
                    Iterator<String> fields = node.fieldNames();
                    while (fields.hasNext() && match == null) {
                        String field = fields.next();
                        if (isIdentifierField(field)) {
                            JsonNode identifierNode = node.get(field);
                            if (!isNullOrMissing(identifierNode)) {
                                match = patchedByIdentifier.get(identifierKey(field, identifierNode));
                            }
                        }
                    }
                }
                if (match != null) {
                    enforceImmutableRecursive(node, match, false);
                }
            });
        }
    }

    private boolean isIdentifierField(String fieldName) {
        return fieldName != null && ("id".equals(fieldName) || fieldName.matches("(?i)(^|.*[_-])id$") || fieldName.endsWith("Id") || fieldName.endsWith("ID"));
    }

    private String identifierKey(String fieldName, JsonNode value) {
        return fieldName + "=" + value.asText();
    }

    private boolean isNullOrMissing(JsonNode node) {
        return node == null || node.isMissingNode() || node.isNull();
    }

    private <T> T filterFields(T value, Object fields, Class<T> targetType) {
        if (value == null || fields == null || targetType == null) {
            return value;
        }
        final String fieldString = fields.toString();
        if (fieldString == null || fieldString.isBlank()) {
            return value;
        }
        Set<String> requested = new LinkedHashSet<>();
        for (String token : fieldString.split(",")) {
            if (token != null && !token.isBlank()) {
                requested.add(token.trim());
            }
        }
        if (requested.isEmpty()) {
            return value;
        }
        if (!requested.contains("id")) {
            requested.add("id");
        }
        try {
            JsonNode node = this.objectMapper.valueToTree(value);
            if (node instanceof ObjectNode objectNode) {
                ObjectNode pruned = objectNode.deepCopy();
                pruned.retain(requested);
                T filtered = this.objectMapper.convertValue(pruned, targetType);
                return isValidResponseBody(filtered) ? filtered : value;
            }
            return value;
        } catch (Exception ex) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Unable to apply field filter", ex);
        }
    }

    private URI buildLocation(Object identifier) {
        Object idValue = identifier != null ? identifier : "";
        try {
            ServletUriComponentsBuilder builder = ServletUriComponentsBuilder.fromCurrentRequestUri();
            if (identifier == null) {
                return builder.build().toUri();
            }
            return builder.pathSegment(idValue.toString()).build().normalize().toUri();
        } catch (IllegalStateException ignored) {
            if (idValue == null || idValue.toString().isBlank()) {
                return URI.create(String.format("/%s", "<%= resolvedResourceSlug %>"));
            }
            return URI.create(String.format("/%s/%s", "<%= resolvedResourceSlug %>", idValue));
        }
    }

    private enum PatchFormat {
        MERGE_PATCH,
        JSON_PATCH,
        JSON_PATCH_QUERY
    }
}
