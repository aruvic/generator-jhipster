    protected <D, S> List<D> mergeCollection(
        List<D> current,
        List<S> incoming,
        Function<D, Object> existingKeyResolver,
        Function<S, Object> incomingKeyResolver,
        BiConsumer<D, S> immutableGuard,
        BiConsumer<D, S> updater,
        Function<S, D> mapper,
        Consumer<D> newItemInitializer
    ) {
        List<D> existingItems = current != null ? new ArrayList<>(current) : new ArrayList<>();
        if (incoming == null) {
            return existingItems;
        }
        final boolean hasKeyResolver = existingKeyResolver != null || incomingKeyResolver != null;
        boolean hasNonNullKey = false;
        if (existingKeyResolver != null) {
            for (D item : existingItems) {
                if (existingKeyResolver.apply(item) != null) {
                    hasNonNullKey = true;
                    break;
                }
            }
        }
        if (!hasNonNullKey && incomingKeyResolver != null) {
            for (S incomingItem : incoming) {
                if (incomingKeyResolver.apply(incomingItem) != null) {
                    hasNonNullKey = true;
                    break;
                }
            }
        }
        if (!hasKeyResolver || !hasNonNullKey) {
            List<D> merged = new ArrayList<>();
            int index = 0;
            for (S incomingItem : incoming) {
                if (index < existingItems.size()) {
                    D existingItem = existingItems.get(index);
                    if (immutableGuard != null) {
                        immutableGuard.accept(existingItem, incomingItem);
                    }
                    if (updater != null) {
                        updater.accept(existingItem, incomingItem);
                    }
                    merged.add(existingItem);
                } else if (mapper != null) {
                    D mappedItem = mapper.apply(incomingItem);
                    if (mappedItem != null) {
                        if (newItemInitializer != null) {
                            newItemInitializer.accept(mappedItem);
                        }
                        merged.add(mappedItem);
                    }
                }
                index++;
            }
            if (index < existingItems.size()) {
                merged.addAll(existingItems.subList(index, existingItems.size()));
            }
            return merged;
        }
        Map<Object, D> currentByKey = new LinkedHashMap<>();
        if (existingKeyResolver != null) {
            for (D item : existingItems) {
                Object key = existingKeyResolver.apply(item);
                if (key != null && !currentByKey.containsKey(key)) {
                    currentByKey.put(key, item);
                }
            }
        }
        List<D> merged = new ArrayList<>();
        Set<Object> seenKeys = new LinkedHashSet<>();
        for (S incomingItem : incoming) {
            D mappedItem = null;
            Object incomingKey = incomingKeyResolver != null ? incomingKeyResolver.apply(incomingItem) : null;
            if (incomingKey == null && existingKeyResolver != null && mapper != null) {
                mappedItem = mapper.apply(incomingItem);
                incomingKey = mappedItem != null ? existingKeyResolver.apply(mappedItem) : null;
            }
            if (incomingKey != null && !seenKeys.add(incomingKey)) {
                continue;
            }
            if (incomingKey != null && currentByKey.containsKey(incomingKey)) {
                D currentItem = currentByKey.get(incomingKey);
                if (immutableGuard != null) {
                    immutableGuard.accept(currentItem, incomingItem);
                }
                if (updater != null) {
                    updater.accept(currentItem, incomingItem);
                }
                merged.add(currentItem);
                continue;
            }
            if (mappedItem == null && mapper != null) {
                mappedItem = mapper.apply(incomingItem);
            }
            if (mappedItem != null) {
                if (newItemInitializer != null) {
                    newItemInitializer.accept(mappedItem);
                }
                merged.add(mappedItem);
            }
        }
        if (existingKeyResolver != null) {
            for (D existingItem : existingItems) {
                Object key = existingKeyResolver.apply(existingItem);
                if (key != null) {
                    if (seenKeys.contains(key)) {
                        continue;
                    }
                    seenKeys.add(key);
                }
                if (!merged.contains(existingItem)) {
                    merged.add(existingItem);
                }
            }
        } else {
            for (D existingItem : existingItems) {
                if (!merged.contains(existingItem)) {
