        BiConsumer<<%- field.elementDomainType %>, <%- field.elementDtoType %>> <%- field.targetField %>Guard = null;
      <%_ } _%>
        List<<%- field.elementDomainType %>> merged<%- field.targetGetter %> = mergeCollection(
            target.get<%- field.targetGetter %>(),
            source.get<%- field.sourceGetter %>(),
            <%- field.targetField %>ExistingKey,
            <%- field.targetField %>IncomingKey,
