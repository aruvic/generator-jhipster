/**
 * MapStruct mapper for <%- entityName %> entity.
 * Uses polymorphic helper mappers for handling abstract types when needed.
 */

package <%- packageName %>;

import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.mapstruct.BeanMapping;
import org.mapstruct.MappingTarget;
import org.mapstruct.NullValuePropertyMappingStrategy;
import org.mapstruct.ReportingPolicy;
import org.mapstruct.AfterMapping;
import org.springframework.context.annotation.Lazy;
import org.springframework.beans.factory.annotation.Autowired;
<%_ if (objectFactories && objectFactories.length > 0) { _%>
import org.mapstruct.ObjectFactory;
<%_ } _%>
<%_ if (entityName === 'JsonPatch') { _%>
import org.mapstruct.Named;
import org.openapitools.jackson.nullable.JsonNullable;
<%_ } _%>

<%_ const hasCollectionMerges = requestMappings.some(mapping => Array.isArray(mapping.collectionFields) && mapping.collectionFields.length > 0); _%>
<%_ const mergeMappers = new Set();
    for (const mapping of requestMappings) {
      for (const field of mapping.collectionFields ?? []) {
        mergeMappers.add(field.mapperFqcn);
      }
    }
    const mergeMappersList = Array.from(mergeMappers);
    const needsMergeHelpers = hasCollectionMerges && mergeMappersList.length > 0;
    const needsMapImports =
      hasCollectionMerges &&
      requestMappings.some(mapping => (mapping.collectionFields ?? []).some(field => (field.keyExpressions ?? []).length > 0));
_%>
<%_ if (needsMapImports) { _%>
import java.util.HashMap;
import java.util.Map;
<%_ } _%>

@Lazy
@Mapper(
  componentModel = "spring",
  unmappedTargetPolicy = ReportingPolicy.IGNORE<%_ if (usesMappers && usesMappers.length > 0) { _%>,
  uses = { <%- usesMappers.map(mapper => mapper + '.class').join(', ') %> }<%_ } _%>
)
public abstract class <%- mapperName %> {

<%_ if (needsMergeHelpers) { mergeMappersList.forEach(fqcn => { _%>
    @Autowired
    protected <%- fqcn %> <%- fqcn.split('.').pop().charAt(0).toLowerCase() + fqcn.split('.').pop().slice(1) %>;
<%_ }); } _%>

    // ========== Request Mappings (DTO -> Domain) ==========
<%_ for (const mapping of requestMappings) { _%>
  <%_ if (mapping.annotations && mapping.annotations.length > 0) { _%>
    <%_ for (const annotation of mapping.annotations) { _%>
    <%- annotation %>
    <%_ } _%>
  <%_ } _%>
  <%_ const hasIdIgnore = (mapping.annotations || []).some(annotation => annotation.includes('target = "id"')); _%>
  <%_ if (!hasIdIgnore) { _%>
    @Mapping(target = "id", ignore = true)
  <%_ } _%>
  <%_ if (entityName === 'JsonPatch') { _%>
    @Mapping(target = "value", qualifiedByName = "unwrapJsonPatchValue")
  <%_ } _%>
    public abstract <%- mapping.targetType %> <%- mapping.methodName %>(<%- mapping.sourceType %> source);

  @BeanMapping(nullValuePropertyMappingStrategy = NullValuePropertyMappingStrategy.IGNORE)
<%_ if (mapping.annotations && mapping.annotations.length > 0) { _%>
  <%_ for (const annotation of mapping.annotations) { _%>
    <%- annotation %>
  <%_ } _%>
<%_ } _%>
  <%_ if (!hasIdIgnore) { _%>
    @Mapping(target = "id", ignore = true)
  <%_ } _%>
  <%_ if (entityName === 'JsonPatch') { _%>
    @Mapping(target = "value", qualifiedByName = "unwrapJsonPatchValue")
  <%_ } _%>
    public abstract void <%- mapping.updateMethodName || `update${mapping.methodName.replace(/^to/, '')}From${mapping.sourceType.split('.').pop()}` %>(@MappingTarget <%- mapping.targetType %> target, <%- mapping.sourceType %> source);

<%_ } _%>

    // ========== Response Mappings (Domain -> DTO) ==========
<%_ for (const mapping of responseMappings) { _%>
  <%_ if (entityName === 'JsonPatch') { _%>
    @Mapping(target = "value", qualifiedByName = "wrapJsonPatchValue")
  <%_ } _%>
  <%_ if (mapping.annotations && mapping.annotations.length > 0) { _%>
    <%_ for (const annotation of mapping.annotations) { _%>
    <%- annotation %>
    <%_ } _%>
  <%_ } _%>
    public abstract <%- mapping.targetType %> <%- mapping.methodName %>(<%- mapping.sourceType %> source);

<%_ } _%>

<%_ if (hasCollectionMerges) { _%>
  <%_ for (const mapping of requestMappings) {
        const collectionFields = mapping.collectionFields ?? [];
        if (collectionFields.length === 0) { continue; }
        const sourceSimple = mapping.sourceType.split('.').pop();
    _%>
    @AfterMapping
    protected void mergeCollectionsFrom<%- sourceSimple %>(@MappingTarget <%- mapping.targetType %> target, <%- mapping.sourceType %> source) {
        if (source == null) {
            return;
        }
    <%_ for (const field of collectionFields) { _%>
        if (source.get<%- field.sourceGetter %>() != null) {
            java.util.List<<%- field.elementDomainType %>> targetItems = target.get<%- field.targetGetter %>();
            if (targetItems == null) {
                targetItems = new java.util.ArrayList<>();
            }
      <%_ const keyExpressions = field.keyExpressions ?? []; _%>
      <%_ if (keyExpressions.length > 0) { _%>
            Map<Object, <%- field.elementDomainType %>> existingByKey = new HashMap<>();
            for (<%- field.elementDomainType %> item : targetItems) {
                Object itemKey = null;
        <%_ for (const expr of keyExpressions) { _%>
                if (itemKey == null) {
                    Object candidateKey = <%- expr.replace(/\{var\}/g, 'item') %>;
                    if (candidateKey != null) {
                        itemKey = candidateKey;
                    }
                }
        <%_ } _%>
                if (itemKey != null) {
                    existingByKey.put(itemKey, item);
                }
            }
            for (<%- field.elementDtoType %> item : source.get<%- field.sourceGetter %>()) {
                <%- field.elementDomainType %> mappedCandidate = this.<%- field.mapperField %>.<%- field.mapMethod %>(item);
                if (mappedCandidate == null) {
                    continue;
                }
                Object itemKey = null;
        <%_ for (const expr of keyExpressions) { _%>
                if (itemKey == null) {
                    Object candidateKey = <%- expr.replace(/\{var\}/g, 'mappedCandidate') %>;
                    if (candidateKey != null) {
                        itemKey = candidateKey;
                    }
                }
        <%_ } _%>
                if (itemKey != null && existingByKey.containsKey(itemKey)) {
                    this.<%- field.mapperField %>.<%- field.updateMethod %>(existingByKey.get(itemKey), item);
                } else {
                    if (mappedCandidate.getId() != null) {
                        mappedCandidate.setId(null);
                    }
                    targetItems.add(mappedCandidate);
                }
            }
      <%_ } else { _%>
            for (<%- field.elementDtoType %> item : source.get<%- field.sourceGetter %>()) {
                <%- field.elementDomainType %> mapped = this.<%- field.mapperField %>.<%- field.mapMethod %>(item);
                if (mapped != null) {
                    if (mapped.getId() != null) {
                        mapped.setId(null);
                    }
                    targetItems.add(mapped);
                }
            }
      <%_ } _%>
            target.<%- field.targetSetter %>(targetItems);
        }
    <%_ } _%>
    }

  <%_ } _%>
<%_ } _%>

<%_ if (objectFactories && objectFactories.length > 0) { _%>
<%_   for (const factory of objectFactories) { _%>

  @ObjectFactory
  protected <%- factory.returnType %> <%- factory.methodName %>(<%- factory.sourceType %> source) {
    if (source == null) {
      return null;
    }
<%_     if (factory.discriminatorAccessor) { _%>
    final String rawDiscriminator = <%- factory.discriminatorAccessor %>;
    final String discriminator = rawDiscriminator != null ? rawDiscriminator : <%- factory.fallbackAccessor %>;
<%_     } else { _%>
    final String discriminator = <%- factory.fallbackAccessor %>;
<%_     } _%>
    if (discriminator == null) {
      return new <%- factory.defaultVariant.instantiationType %>();
    }
    switch (discriminator) {
<%_     for (const variant of factory.variants) { _%>
    case <%- variant.discriminatorLiteral %>:
      return new <%- variant.instantiationType %>();
<%_     } _%>
    default:
      return new <%- factory.defaultVariant.instantiationType %>();
    }
  }
<%_   } _%>
<%_ } _%>

<%_ if (entityName === 'JsonPatch') { _%>
  @Named("unwrapJsonPatchValue")
  protected String unwrapJsonPatchValue(JsonNullable<Object> value) {
    if (value == null || !value.isPresent()) {
      return null;
    }
    final Object resolved = value.orElse(null);
    return resolved != null ? resolved.toString() : null;
  }

  @Named("wrapJsonPatchValue")
  protected JsonNullable<Object> wrapJsonPatchValue(Object value) {
    return value != null ? JsonNullable.of(value) : JsonNullable.undefined();
  }
<%_ } _%>
}
