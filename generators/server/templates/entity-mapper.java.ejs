  private static final class JsonPatchValueSupport {
    private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper();

    private JsonPatchValueSupport() {}

    static Object toStructuredValue(Object value) {
      if (value == null) {
        return null;
      }
      if (value instanceof JsonNode) {
        return value;
      }
      if (value instanceof String stringValue) {
        String trimmed = stringValue.trim();
        if (trimmed.isEmpty()) {
          return stringValue;
        }
        try {
          return OBJECT_MAPPER.readTree(trimmed);
        } catch (JsonProcessingException ex) {
          throw badRequest("Unable to deserialize JSON Patch value", ex);
        }
      }
      return value;
    }

    static String toJsonString(Object value) {
      if (value == null) {
        return null;
      }
      try {
        if (value instanceof String stringValue) {
          String trimmed = stringValue.trim();
          if (trimmed.isEmpty()) {
            return OBJECT_MAPPER.writeValueAsString(stringValue);
          }
          if (looksLikeJson(trimmed)) {
            return OBJECT_MAPPER.writeValueAsString(OBJECT_MAPPER.readTree(trimmed));
          }
          return OBJECT_MAPPER.writeValueAsString(stringValue);
        }
        if (value instanceof JsonNode node) {
          return OBJECT_MAPPER.writeValueAsString(node);
        }
        return OBJECT_MAPPER.writeValueAsString(OBJECT_MAPPER.valueToTree(value));
      } catch (JsonProcessingException ex) {
        throw badRequest("Unable to serialize JSON Patch value", ex);
      }
    }

    private static boolean looksLikeJson(String value) {
      if (value.isEmpty()) {
        return false;
      }
      char first = value.charAt(0);
      return first == '{' || first == '[' || first == '"' || first == '\'' || Character.isDigit(first) || first == '-';
    }

    private static ResponseStatusException badRequest(String message, Exception ex) {
      return new ResponseStatusException(HttpStatus.BAD_REQUEST, message, ex);
    }
  }
