    protected <D, S> List<D> mergeCollection(
        List<D> current,
        List<S> incoming,
        Function<D, Object> existingKeyResolver,
        Function<S, Object> incomingKeyResolver,
        BiConsumer<D, S> immutableGuard,
        BiConsumer<D, S> updater,
        Function<S, D> mapper
    ) {
        List<D> existingItems = current != null ? new ArrayList<>(current) : new ArrayList<>();
        if (incoming == null) {
            return new ArrayList<>();
        }
        Map<Object, D> currentByKey = new LinkedHashMap<>();
        if (existingKeyResolver != null) {
            for (D item : existingItems) {
                Object key = existingKeyResolver.apply(item);
                if (key != null && !currentByKey.containsKey(key)) {
                    currentByKey.put(key, item);
                }
            }
        }
        List<D> merged = new ArrayList<>();
        Set<Object> seenKeys = new LinkedHashSet<>();
        for (S incomingItem : incoming) {
            Object incomingKey = incomingKeyResolver != null ? incomingKeyResolver.apply(incomingItem) : null;
            if (incomingKey != null && !seenKeys.add(incomingKey)) {
                continue;
            }
            if (incomingKey != null && currentByKey.containsKey(incomingKey)) {
                D currentItem = currentByKey.get(incomingKey);
                if (immutableGuard != null) {
                    immutableGuard.accept(currentItem, incomingItem);
                }
                if (updater != null) {
                    updater.accept(currentItem, incomingItem);
                }
                merged.add(currentItem);
                continue;
            }
            D mappedItem = mapper != null ? mapper.apply(incomingItem) : null;
            if (mappedItem != null) {
                merged.add(mappedItem);
            }
        }
        return merged;
    }
