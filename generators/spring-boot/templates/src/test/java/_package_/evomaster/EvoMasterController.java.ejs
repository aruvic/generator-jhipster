    @Override
    public String startSut() {
        System.setProperty("liquibase.analytics.enabled", System.getProperty("liquibase.analytics.enabled", "false"));
        List<String> args = new ArrayList<>();
        args.add("--server.port=0");
        args.add("--spring.profiles.active=" + envOrDefault("EVOMASTER_SPRING_PROFILES", "dev,api-docs"));
        args.add("--spring.docker.compose.enabled=false");
        args.add("--spring.main.allow-circular-references=" + envOrDefault("EVOMASTER_ALLOW_CIRCULAR_REFERENCES", "true"));
        args.add("--spring.main.allow-bean-definition-overriding=" + envOrDefault("EVOMASTER_ALLOW_BEAN_DEFINITION_OVERRIDING", "true"));
        args.add("--spring.liquibase.contexts=" + envOrDefault("EVOMASTER_LIQUIBASE_CONTEXTS", "dev"));
        args.add("--spring.datasource.hikari.maximum-pool-size=" + envOrDefault("EVOMASTER_HIKARI_MAXIMUM_POOL_SIZE", "50"));
        args.add("--spring.datasource.hikari.connection-timeout=" + envOrDefault("EVOMASTER_HIKARI_CONNECTION_TIMEOUT_MS", "60000"));
        args.add("--logging.level.ROOT=" + envOrDefault("EVOMASTER_LOG_LEVEL", "INFO"));
        args.add("--logging.level.<%- packageName %>=" + envOrDefault("EVOMASTER_APP_LOG_LEVEL", "INFO"));
        args.add("--logging.level.org.hibernate.SQL=" + envOrDefault("EVOMASTER_SQL_LOG_LEVEL", "INFO"));
        args.add("--logging.level.org.eclipse.jetty=" + envOrDefault("EVOMASTER_JETTY_LOG_LEVEL", "INFO"));

        addIfPresent(args, "spring.datasource.url", "EVOMASTER_DB_URL");
        addIfPresent(args, "spring.datasource.username", "EVOMASTER_DB_USERNAME");
        addIfPresent(args, "spring.datasource.password", "EVOMASTER_DB_PASSWORD");

        waitForConfiguredDatabase();
        context = SpringApplication.run(<%- mainClass %>.class, args.toArray(String[]::new));
        DataSource dataSource = context.getBeanProvider(DataSource.class).getIfAvailable();
        try {
            connection = openEvoMasterConnection(dataSource);
        } catch (SQLException e) {
            throw new IllegalStateException("Cannot open datasource connection for EvoMaster", e);
        }
        registerLiquibaseCheckEnumConstraintsForEvoMaster();
        return "http://localhost:" + getSutPort();
    }

    @Override
    public void stopSut() {
        if (connection != null) {
            try {
                connection.close();
            } catch (SQLException ignored) {
                // Connection cleanup must not hide the original EvoMaster result.
            }
        }
        connection = null;
        if (context != null) {
            context.close();
        }
        context = null;
    }

