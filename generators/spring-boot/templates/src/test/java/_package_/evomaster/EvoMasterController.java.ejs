    }

    private Connection connectionForEvoMaster() {
        if (
            connection == null ||
            !Boolean.parseBoolean(envOrDefault("EVOMASTER_SANITIZE_SQL_STATEMENTS", "true"))
        ) {
            return connection;
        }
        return (Connection) Proxy.newProxyInstance(
            Connection.class.getClassLoader(),
            new Class<?>[] { Connection.class },
            new SanitizingConnectionHandler(connection)
        );
    }

    private final class SanitizingConnectionHandler implements InvocationHandler {

        private final Connection delegate;

        private SanitizingConnectionHandler(Connection delegate) {
            this.delegate = delegate;
        }

        @Override
        public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
            Object[] sanitizedArgs = sanitizeSqlArgument(method.getName(), args);
            try {
                Object result = method.invoke(delegate, sanitizedArgs);
                if (result instanceof Statement statement) {
                    return sanitizingStatement(statement);
                }
                return result;
            } catch (InvocationTargetException e) {
                throw e.getCause();
            }
        }
    }

    private Object sanitizingStatement(Statement statement) {
        Set<Class<?>> interfaces = new LinkedHashSet<>();
        if (statement instanceof java.sql.CallableStatement) {
            interfaces.add(java.sql.CallableStatement.class);
        }
        if (statement instanceof java.sql.PreparedStatement) {
            interfaces.add(java.sql.PreparedStatement.class);
        }
        interfaces.add(Statement.class);
        return Proxy.newProxyInstance(
            Statement.class.getClassLoader(),
            interfaces.toArray(Class<?>[]::new),
            new SanitizingStatementHandler(statement)
        );
    }

    private final class SanitizingStatementHandler implements InvocationHandler {

        private final Statement delegate;

        private SanitizingStatementHandler(Statement delegate) {
            this.delegate = delegate;
        }

        @Override
        public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
            try {
                return method.invoke(delegate, sanitizeSqlArgument(method.getName(), args));
            } catch (InvocationTargetException e) {
                throw e.getCause();
            }
        }
    }

    private Object[] sanitizeSqlArgument(String methodName, Object[] args) {
        if (args == null || args.length == 0 || !(args[0] instanceof String sql) || !canCarrySql(methodName)) {
            return args;
        }
        Object[] copy = args.clone();
        copy[0] = sanitizeSqlStatement(sql);
        return copy;
    }

    private static boolean canCarrySql(String methodName) {
        return switch (methodName) {
            case "addBatch",
                "execute",
                "executeLargeUpdate",
                "executeQuery",
                "executeUpdate",
                "nativeSQL",
                "prepareCall",
                "prepareStatement" -> true;
            default -> false;
        };
    }

