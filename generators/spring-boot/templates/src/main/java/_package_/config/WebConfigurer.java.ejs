    @Override
    public void onStartup(ServletContext servletContext) {
        if (env.getActiveProfiles().length != 0) {
            LOG.info("Web application configuration, using profiles: {}", (Object[]) env.getActiveProfiles());
        }

  <%_ if (devDatabaseTypeH2Any) { _%>
        if (h2ConsoleIsEnabled(env)) {
            initH2Console(servletContext);
        }
  <%_ } _%>
        LOG.info("Web application fully configured");
    }
  <%_ if (!skipClient) { _%>

    /**
     * Customize the Servlet engine: Mime types, the document root, the cache.
     */
    @Override
    public void customize(WebServerFactory server) {
        // When running in an IDE or with <% if (buildToolGradle) { %>./gradlew bootRun<% } else { %>./mvnw spring-boot:run<% } %>, set location of the static web assets.
        setLocationForStaticAssets(server);
    }

    private void setLocationForStaticAssets(WebServerFactory server) {
        if (server instanceof ConfigurableServletWebServerFactory servletWebServer) {
            File root;
            String prefixPath = resolvePathPrefix();
            root = Path.of(prefixPath + "<%= clientDistDir %>").toFile();
            if (root.exists() && root.isDirectory()) {
                servletWebServer.setDocumentRoot(root);
            }
        }
    }

    /**
     * Resolve path prefix to static resources.
     */
    private String resolvePathPrefix() {
        String fullExecutablePath = decode(this.getClass().getResource("").getPath(), StandardCharsets.UTF_8);
        String rootPath = Path.of(".").toUri().normalize().getPath();
        String extractedPath = fullExecutablePath.replace(rootPath, "");
        int extractionEndIndex = extractedPath.indexOf("<%= temporaryDir %>");
        if (extractionEndIndex <= 0) {
            return "";
        }
        return extractedPath.substring(0, extractionEndIndex);
    }
  <%_ } _%>
<%_ } _%>

    @Bean
    public <% if (reactive) { %>CorsConfigurationSource corsConfigurationSource()<% } else { %>CorsFilter corsFilter()<% } %> {
        UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
        CorsConfiguration config = jHipsterProperties.getCors();
        if (!CollectionUtils.isEmpty(config.getAllowedOrigins()) || !CollectionUtils.isEmpty(config.getAllowedOriginPatterns())) {
            LOG.debug("Registering CORS filter");
            source.registerCorsConfiguration("/api/**", config);
            source.registerCorsConfiguration("/management/**", config);
            source.registerCorsConfiguration("/v3/api-docs", config);
            source.registerCorsConfiguration("/swagger-ui/**", config);
<%_ if (applicationTypeGateway) { _%>
            source.registerCorsConfiguration("/*/api/**", config);
            source.registerCorsConfiguration("/services/*/api/**", config);
            source.registerCorsConfiguration("/*/management/**", config);
<%_ } _%>
        }
        return <% if (reactive) { %>source<% } else { %>new CorsFilter(source)<% } %>;
    }
<%_ if (!reactive) { _%>

    @Bean
    public FilterRegistrationBean<OncePerRequestFilter> requestBodyCachingFilter() {
        FilterRegistrationBean<OncePerRequestFilter> registration = new FilterRegistrationBean<>();
        registration.setFilter(new OncePerRequestFilter() {
            @Override
            protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain filterChain)
                throws ServletException, IOException {
                ContentCachingRequestWrapper wrapped =
                    request instanceof ContentCachingRequestWrapper ? (ContentCachingRequestWrapper) request : new ContentCachingRequestWrapper(request);
                filterChain.doFilter(wrapped, response);
            }
        });
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE + 10);
        return registration;
    }

    @Override
    public void extendMessageConverters(List<HttpMessageConverter<?>> converters) {
        LOG.debug("Ensuring JsonPatchMessageConverter is first in message converters");
        converters.removeIf(converter -> converter instanceof JsonPatchMessageConverter);
        converters.add(0, jsonPatchMessageConverter());
        converters
            .stream()
            .filter(converter -> converter instanceof MappingJackson2HttpMessageConverter && !(converter instanceof JsonPatchMessageConverter))
            .map(MappingJackson2HttpMessageConverter.class::cast)
            .forEach(converter -> {
                LOG.debug("Filtering supported media types for converter {}: {}", converter.getClass().getSimpleName(), converter.getSupportedMediaTypes());
                List<MediaType> filtered = converter
                    .getSupportedMediaTypes()
                    .stream()
                    .filter(mediaType -> !isJsonPatchMediaType(mediaType))
                    .toList();
                if (filtered.stream().noneMatch(mediaType -> mediaType.isCompatibleWith(MERGE_PATCH_MEDIA_TYPE))) {
                    filtered = Stream.concat(filtered.stream(), Stream.of(MERGE_PATCH_MEDIA_TYPE)).toList();
                }
                LOG.debug("Updated supported media types for converter {}: {}", converter.getClass().getSimpleName(), filtered);
                converter.setSupportedMediaTypes(filtered);
            });
        IntStream.range(0, converters.size())
            .forEach(index -> LOG.debug("#{} converter={} mediaTypes={}", index, converters.get(index).getClass().getName(), converters.get(index).getSupportedMediaTypes()));
    }

    @Bean
    @Order(Ordered.HIGHEST_PRECEDENCE)
    public HttpMessageConverter<?> jsonPatchMessageConverter() {
        return new JsonPatchMessageConverter(objectMapper);
    }

    private boolean isJsonPatchMediaType(MediaType mediaType) {
        if (mediaType == null) {
            return false;
        }
        return JSON_PATCH_MEDIA_TYPES.stream().anyMatch(patchMediaType ->
            patchMediaType.getType().equalsIgnoreCase(mediaType.getType()) && patchMediaType.getSubtype().equalsIgnoreCase(mediaType.getSubtype())
        );
    }

    private static final class JsonPatchMessageConverter extends MappingJackson2HttpMessageConverter {

        JsonPatchMessageConverter(ObjectMapper objectMapper) {
            super(objectMapper);
            setSupportedMediaTypes(JSON_PATCH_MEDIA_TYPES);
        }

        @Override
        public boolean canRead(Class<?> clazz, MediaType mediaType) {
            boolean result = isJsonPatch(mediaType) || super.canRead(clazz, mediaType);
            LOG.debug("JsonPatchMessageConverter canRead clazz={} mediaType={} -> {}", clazz.getSimpleName(), mediaType, result);
            return result;
        }

        @Override
        public boolean canRead(java.lang.reflect.Type type, Class<?> contextClass, MediaType mediaType) {
            boolean result = isJsonPatch(mediaType) || super.canRead(type, contextClass, mediaType);
            LOG.debug(
                "JsonPatchMessageConverter canRead type={} contextClass={} mediaType={} -> {}",
                type.getTypeName(),
                contextClass != null ? contextClass.getSimpleName() : null,
                mediaType,
                result
            );
            return result;
        }

        @Override
        protected Object readInternal(Class<?> clazz, HttpInputMessage inputMessage) throws IOException {
            return readPayload(clazz, null, inputMessage);
        }

        @Override
        public Object read(java.lang.reflect.Type type, Class<?> contextClass, HttpInputMessage inputMessage)
            throws IOException, HttpMessageNotReadableException {
            return readPayload(type, contextClass, inputMessage);
        }

        private Object readPayload(java.lang.reflect.Type type, Class<?> contextClass, HttpInputMessage inputMessage) throws IOException {
            MediaType contentType = inputMessage.getHeaders().getContentType();
            JsonNode parsed = this.getObjectMapper().readTree(inputMessage.getBody());
            boolean parsedIsArray = parsed != null && parsed.isArray();
            LOG.debug(
                "JsonPatchMessageConverter read type={} contextClass={} contentType={} parsedIsArray={}",
                type != null ? type.getTypeName() : null,
                contextClass != null ? contextClass.getSimpleName() : null,
                contentType,
                parsedIsArray
            );
            final boolean treatAsJsonPatch = isJsonPatch(contentType) || parsedIsArray;
            if (treatAsJsonPatch) {
                LOG.debug("JsonPatchMessageConverter returning empty instance for {}", type != null ? type.getTypeName() : null);
                return instantiateEmpty(type);
            }
            if (parsed == null || parsed.isMissingNode()) {
                return instantiateEmpty(type);
            }
            JavaType javaType = this.getObjectMapper().getTypeFactory().constructType(type);
            return this.getObjectMapper().treeToValue(parsed, javaType);
        }

        private boolean isJsonPatch(MediaType mediaType) {
            if (mediaType == null) {
                return false;
            }
            return JSON_PATCH_MEDIA_TYPES.stream().anyMatch(patchMediaType ->
                patchMediaType.getType().equalsIgnoreCase(mediaType.getType()) && patchMediaType.getSubtype().equalsIgnoreCase(mediaType.getSubtype())
            );
        }

        private Object instantiateEmpty(Class<?> clazz) {
            try {
                return clazz.getDeclaredConstructor().newInstance();
            } catch (Exception ex) {
                return this.getObjectMapper().convertValue(this.getObjectMapper().createObjectNode(), clazz);
            }
        }

        private Object instantiateEmpty(java.lang.reflect.Type type) {
            if (type instanceof Class<?> clazz) {
                return instantiateEmpty(clazz);
            }
            try {
                JavaType javaType = this.getObjectMapper().getTypeFactory().constructType(type);
                return this.getObjectMapper().convertValue(this.getObjectMapper().createObjectNode(), javaType);
            } catch (IllegalArgumentException ex) {
                return this.getObjectMapper().createObjectNode();
            }
        }
    }
