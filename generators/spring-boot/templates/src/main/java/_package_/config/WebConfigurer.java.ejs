<%_ if (!reactive) { _%>
    private static final List<MediaType> JSON_PATCH_MEDIA_TYPES = List.of(
        MediaType.valueOf("application/json-patch+json"),
        MediaType.valueOf("application/json-patch-query+json")
    );
    private static final MediaType MERGE_PATCH_MEDIA_TYPE = MediaType.valueOf("application/merge-patch+json");

    private final Environment env;

<%_ } _%>
