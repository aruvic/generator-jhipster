{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.jhipster.tech/schemas/oas-regression/external-prerequisites.schema.json",
  "title": "External prerequisite fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixtures"],
  "properties": {
    "version": {
      "const": 1
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "resources"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\r\\n\\u0000]+$"
          }
        },
        "configuration": {
          "type": "object"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "canonicalRead", "enabledOperations"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "identity": {
          "type": "object",
          "minProperties": 1
        },
        "canonicalRead": {
          "$ref": "#/$defs/canonicalRead"
        },
        "enabledOperations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selector"
          }
        }
      }
    },
    "canonicalRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "pathParameters", "expectedStatuses", "assertions"],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
        },
        "pathParameters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
          }
        },
        "expectedStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 200,
            "maximum": 299
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pointer", "operator", "value"],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
            },
            "operator": {
              "enum": ["equals", "notEquals", "includes"]
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pointer", "operator", "value"],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
            },
            "operator": {
              "const": "exists"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {
          "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE"]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?!.*[?#])(?:[^{}]|\\{[A-Za-z0-9._-]+\\})*$"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
