+    protected fun updateGeneWithParameterValue(gene: ChoiceGene<*>, paramName: String, paramValue: String): Boolean {
+        for ((index, child) in gene.getViewOfChildren().withIndex()) {
+            val copy = child.copy()
+            if (updateGenesRecursivelyWithParameterValue(copy, copy.name, paramValue) && child.copyValueFrom(copy)) {
+                gene.selectActiveGene(index)
+                return true
+            }
+        }
+        return logWarningAndReturnFalse(WARN_WRONG_VALUE, "choice", paramName, "choice", paramValue)
+    }
